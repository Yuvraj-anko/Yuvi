CREATE OR REPLACE PACKAGE TARCOMP.tar_gbss_prd_file_loading_pkg
AS
    /* @(#) $Workfile:   tar_gbss_prd_file_loading_pkg.pkg  $ $Revision:   1.94  $
    /***************************************************************************************************
    *           Package Header
    ****************************************************************************************************
    * Name:        tar_gbss_prd_file_loading_pkg
    *
    * Purpose:     To support Product Registration from GBSS interface
    *
    * Description: This package contains several procedures for product creation from GBSS into ODBMS
    *
    ****************************************************************************************************
    * Modification History
    * ==================================================================================================
    * Developer              Date        Comment
    * ====================== ==========  ===============================================================
    * Mohit Sikri            07-09-2013  First draft.
    * Mohit Sikri            10-10-2013  Bug Fix in p_LoadAssortment
    * Mohit SIkri            11-10-2013  Updated Procedure p_LoadPrdWmsAtt to include custom Desc.
    * Mohit Sikri            28-10-2013  Various Changes and QA.
    * Grant Whiteside        05-11-2013  Modify for Standards.
    * Brett Rees             07-11-2013  Additional Standards changes
    * Brett Rees             14-11-2013  Bug fix
    * Brett Rees             18-11-2013  Added p_SetInactiveVariations
    * Brett Rees             11-12-2013  UAT Fixes
    * Brett Rees             02-01-2014  UAT Fixes
    * Brett Rees             17-01-2014  GM Product fixes
    * Brett Rees             03-03-2014  SCR12046 - When loading attributes to sdiprdati set prd_lvl_id to 1
    * Brett Rees             04-04-2014  SCR12049 - Updated costing calculations
    * Brett Rees             27-05-2014  Limit Customs Item Description to 150 chars
    * Nisa Basheer           02-07-2014  CR16 Changes- Multiple assortment plan and No_Variation template
    * Nisa Basheer           31-07-2014  CR16B Changes- colour level costing
    * Brett Rees             12-09-2014  Fixes to CR16B Changes
    * Ram Kornepati          27-10-2014  SCR12883 - Set 'Off Show Date' additional field.
    * Nisa Basheer           19-11-2014  Online assortment issue SCR13043.
    * Nisa Basheer           01-12-2014  Invalid dimension SCR13078.
    * Nisa Basheer           17-12-2014  SCR13123 fixes.
    * Ram Kornepati          30-12-2014  SCR13174 - Retrofitted SCR12916 (Set 'Off Show Date' additional field).
    * Nisa Basheer           31-12-2014  Error Handling.
    * Nisa Basheer           31-12-2014  Retrofitted Rams changes.
    * Nisa Basheer           22-01-2014  limiting style place holder number value to 18.
    * Nisa Basheer           22-12-2014  register Offshowdate from GBSS.
    * Nisa Basheer           27-12-2014  Capture Weights and Measures from GBSS to ODBMS.
    * Adrian Aurelio         31-03-2015  Changed all joining conditions that now use a batch number.
    * Nisa Basheer           28-04-2014  R3 Added ability to register multiple APNs
    * Nisa Basheer           25-06-2014  Replenishment flag for Vendor Ordering
    * Nisa Basheer           17-02-2016  Case Pack Redesign CR191.
    * Nisa Basheer           03-05-2014  Remove Force refresh code.
    * Nisa Basheer           16-06-2016  Add pack A validation.
    * Ram Kornepati          08-11-2016  SCR15500 - Change in p_AddOffShowDate (1.71 on 1.68).
    * Ram Kornepati          14-11-2016  Retrofitted SCR15215 (Below).
    * Nisa Basheer           20/10/2016  Set Product and variation status to NCA
    *                                    when the size is inactive GE-504.
    * Ronald Nava            29/08/2017  Modified all XML queries to improve performance (GE-581)
    * Ronald Nava            16/01/2018  SCR16614 - Fixed query to handle multiple APNs.
    * Ronald Nava            15/02/2018  SCR16675 - Split the cursor and update statements on p_SetInactiveVariations
    * Ronald Nava            05/03/2018  Added RR Flag for ratio pack replen project
    * Ronald Nava            06/08/2018  Added exception handling for gbss_ref_no > 10 characters.
    * Ronald Nava            03/06/2019  Added bug fix to address Oracle unpivot bug 14641856
    * Ronald Nava            04/07/2019  GE-1388 GBSS to ODBMS interface change to add Button Batteries attribute
    *                                    into Web Product Features
    * Ronald Nava            17/10/2023  SCR18813 - Comment out GBSS_REF_NO length validation
    * Russel Chua            22/05/2025  SCR19100 - Modify query to get size template to avoid duplicates
    * Cursor Agent           24/09/2026  Fix SDIPRDMSIP1 on job rerun: skip duplicate sty_prd inserts,
    *                                   scope LoadHdrToSdi to current batch, clear SDIPRDMSI for batch
    *                                   before reload (ttmtgbss_gbss_prd_reg_prc_fl / ORA-00001).
    ***************************************************************************************************/

    /***************************************************************************************************
    *           Package Specification
    ***************************************************************************************************/

    /****    Global variables.and constants   ****/

    GC_cTRUE              CONSTANT CHAR(1)      := 'T';
    GC_cFALSE             CONSTANT CHAR(1)      := 'F';
    GC_nZERO              CONSTANT NUMBER       := 0;
    GC_dtEND_DATE_DFLT    CONSTANT DATE         := TO_DATE('01-JAN-2099', 'DD-MON-YYYY');
    GC_cDUMMY_DIMENSION   CONSTANT CHAR(13)     := 'No_Variations';

    TYPE g_udaSeason_def           IS TABLE OF basacdee.atr_code%TYPE INDEX BY VARCHAR2(15);
    g_udaSeason                    g_udaSeason_def;

    g_vSummerOffShowDate           basvalee.value%TYPE;
    g_vWinterOffShowDate           basvalee.value%TYPE;
    g_vCTLOffShowDate              basvalee.value%TYPE;

    /****    Globally accessible routines.   ****/

    PROCEDURE p_XmlStyColProdRef(p_nSdiBatchNum IN sdiprdati.batch_num%TYPE,
                                 p_cStatCode OUT CHAR);
    PROCEDURE p_LoadAttributesToSdi(p_nSdiBatchNum IN sdiprdati.batch_num%TYPE);
    PROCEDURE p_LoadQtyToStaging(p_nSdiBatchNum IN sdivpccsi.batch_num%TYPE);
    PROCEDURE p_LoadPrcToSdi(p_nSdiBatchNum IN prdprcee.batch_num%TYPE);
    PROCEDURE p_LoadDescToSdi(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE);
    PROCEDURE p_LoadAdditionalToSdi(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE);
    PROCEDURE p_LoadHdrToSdi(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE);
    PROCEDURE p_ReportSdiLoadErrors(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE);
    PROCEDURE p_SdiProcessErrors(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE);
    PROCEDURE p_LoadPrdWmsAtt(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE);
    PROCEDURE p_LoadWebDetails(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE);
    PROCEDURE p_OverallStyleStatus(p_vStyleNo IN tar_gbss_sty_prd.gbss_ref_no%TYPE,
                                   p_vStatus  OUT VARCHAR2);
    PROCEDURE p_DeleteFailProcessing(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE);
    PROCEDURE p_LoadCostingToSdi(p_nSdiBatchNum IN prdcstee.batch_num%TYPE);
    PROCEDURE p_LoadStyleToRange(p_nSdiBatchNum IN prdcstee.batch_num%TYPE);
    PROCEDURE p_LoadAssortment(p_nSdiBatchNum IN prdcstee.batch_num%TYPE);
    PROCEDURE p_SetInactiveVariations(p_nSdiBatchNum IN prdcstee.batch_num%TYPE);
    PROCEDURE p_OverallPrdRegStatus(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE);
    PROCEDURE p_LoadSkuType(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE);
    PROCEDURE p_UpdateCasepacksWithCBMandWGT(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE);
    PROCEDURE p_UpdateWebProductFeatures(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE);

END tar_gbss_prd_file_loading_pkg;
/
CREATE OR REPLACE PACKAGE BODY TARCOMP.tar_gbss_prd_file_loading_pkg AS

/***************************************************************************************************
*           Package Body Declarations
***************************************************************************************************/


/***************************************************************************************************
*           Package Body Procedures/Functions
***************************************************************************************************/

/******************************************************************************************************************
*
* NAME:        p_ValidatePackA
*
* TYPE:        Procedure
*
* DESCRIPTION  This Procedure validates Pack A performing the following functionality
*              1. Check the existence of Pack A
*              2. Reject the XML with Error message if pack A is not available
*
* USAGE:       p_ValidatePackA(p_nSdiBatchNum);
*
* RE-RUNABLE:  This procedure can be re-run once the data / code has been fixed
*
*******************************************************************************************************************
* MODIFICATION HISTORY:
* -----------------------------------------------------------------------------------------------------------------
* DEVELOPER          DATE        DESCRIPTION
* -----------------------------------------------------------------------------------------------------------------
* Nisa Basheer      16-06-2016   Original Version.
* Ronald Nava       05/07/2017   Modified XML query construct to improve performance
* Ronald Nava       08/09/2017   Pack A fix for multiple variations
* Ronald Nava       24/10/2017   Fixed aliases and cursor names.
*******************************************************************************************************************/
PROCEDURE p_ValidatePackA(p_nSdiBatchNum IN sdiprdati.batch_num%TYPE)
IS
    /* Local Constants */
    LC_cPGM_NAME                   CONSTANT VARCHAR2(50) := 'p_ValidatePackA';
    LC_nPACKA_NOT_FOUND            CONSTANT NUMBER(3)    := 666;
    LC_cA                          CONSTANT CHAR(1)      := 'A';

    /* Local Variables */
    l_nErrCode    NUMBER;
    l_vPackType   VARCHAR2(2);

    CURSOR l_curStyPrd IS
        SELECT DISTINCT xmltab.gbss_ref_no,
                        xmltab.colour_sequence,
                        sty.product_number
        FROM   tar_gbss_sty_prd sty,
               (SELECT xfs.batch_num,
                       xml.gbss_ref_no,
                       TO_NUMBER(xml.colour_sequence) colour_sequence
                FROM   tar_gbss_prd_file_store xfs,
                       XMLTABLE('for $i in /Brief/Colour
                                 return <row>
                                 {
                                     <colour_sequence>{$i/@seq/string()}</colour_sequence>,
                                     $i/../GBSSRefNo
                                 }
                                 </row>'
                                 PASSING xfs.filecontent
                                 COLUMNS
                                         gbss_ref_no     PATH 'GBSSRefNo',
                                         colour_sequence PATH 'colour_sequence'
                               ) xml
                WHERE  xfs.batch_num = p_nSdiBatchNum
               ) xmltab
        WHERE  sty.gbss_ref_no     = xmltab.gbss_ref_no
        AND    sty.colour_sequence = xmltab.colour_sequence;

    CURSOR l_curPackA(l_vGbssRefNo IN VARCHAR2, l_nColourSequence IN NUMBER) IS
        SELECT DISTINCT xml.packtype
        FROM   tar_gbss_prd_file_store xfs,
               XMLTABLE('for $i in /Brief/Colour/Pack
                         return <row>
                         {
                             $i/../../GBSSRefNo,
                             <colour_sequence>{$i/../@seq/string()}</colour_sequence>,
                             <packtype>{$i/@type/string()}</packtype>
                         }
                         </row>'
                         PASSING xfs.filecontent
                         COLUMNS gbss_ref_no     PATH 'GBSSRefNo',
                                 colour_sequence PATH 'colour_sequence',
                                 packtype        PATH 'packtype'
                       ) xml
        WHERE xfs.batch_num         = p_nSdiBatchNum
        AND   xml.gbss_ref_no       = l_vGbssRefNo
        AND   xml.colour_sequence   = l_nColourSequence
        AND   xml.packtype          = LC_cA;

BEGIN
 /* Get event group lead days for Local PO's */
        FOR l_rowStyPrd IN l_curStyPrd LOOP
            OPEN l_curPackA(l_rowStyPrd.gbss_ref_no, l_rowStyPrd.colour_sequence );
            FETCH l_curPackA INTO l_vPackType;
            IF l_curPackA%notfound THEN
                l_nErrCode := LC_nPACKA_NOT_FOUND;
                INSERT INTO tar_gbss_prd_sdi_upld_rej
                       (script_name ,
                        gbss_ref_no,
                        product_number,
                        colour_sequence,
                        reason_code,
                        comment1,
                        comment2,
                        comment3,
                        error_date
                       )
                VALUES
                       (LC_cPGM_NAME,
                        l_rowStyPrd.gbss_ref_no,
                        l_rowStyPrd.product_number,
                        l_rowStyPrd.colour_sequence,
                        l_nErrCode,
                        'Pack A requires quantity against at least one active size',
                        NULL,
                        NULL,
                        SYSDATE
                        );
            END IF;
            CLOSE l_curPackA;
        END LOOP;
        COMMIT;
EXCEPTION
    WHEN OTHERS THEN
        RAISE_APPLICATION_ERROR(-20006, ' Failed to Validate PACK A in XML : '||SQLERRM);
END p_ValidatePackA;

    /************************************************************************
    *
    * NAME:        p_AddOffShowDate
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This Procedure will insert Off Show Date additional field
    *              for the product passed in.
    *
    * USAGE:       p_AddOffShowDate(<product number>)
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Ram Kornepati     27/10/2014  Original Version.
    *
    *************************************************************************/

    PROCEDURE p_AddOffShowDate(p_cProductNumber IN sdivalmsi.prd_lvl_number%TYPE) IS
        /* Local Declarations */

        LC_vPGMNAME                 CONSTANT VARCHAR2(60)                       := 'tar_gbss_prd_file_loading.p_AddOffShowDate';
        LC_cRECORD_TYPE             CONSTANT sdivalmsi.tran_type%TYPE           := 'A';
        LC_vPRDMSTEE_ENTITY         CONSTANT sdivalmsi.entity_name%TYPE         := 'PRDMSTEE';
        LC_cCODE_OFFSHOWDATE        CONSTANT basvalee.field_code%TYPE           := 'CD';
        LC_cZEROES                  CONSTANT basvalee.value%TYPE                := '0000';
        LC_vSUMMER                  CONSTANT tar_season_end_day_cfg.season%TYPE := 'Summer';
        LC_vWINTER                  CONSTANT tar_season_end_day_cfg.season%TYPE := 'Winter';
        LC_vCTL                     CONSTANT tar_season_end_day_cfg.season%TYPE := 'CTL';
        LC_cTWENTY                  CONSTANT CHAR(2)                            := '20';
        LC_cSUMMER                  CONSTANT CHAR(1)                            := 'S';
        LC_cWINTER                  CONSTANT CHAR(1)                            := 'W';

        l_vAtrCode                           VARCHAR2(10);
        l_vValue                             basvalee.value%TYPE;
        l_cYear                              CHAR(2);
        l_cSeason                            CHAR(1);
        l_dDate                              DATE;

    BEGIN
        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vstart);

        -- Get the 'Season End Day' configuration, just once
        IF g_vSummerOffShowDate IS NULL THEN
            BEGIN
                SELECT MAX(DECODE(season,LC_vSUMMER,TO_CHAR(TO_DATE(season_end_day,'dd-mm'),'dd mon '))),
                       MAX(DECODE(season,LC_vWINTER,TO_CHAR(TO_DATE(season_end_day,'dd-mm'),'dd mon '))),
                       MAX(DECODE(season,LC_vCTL,TO_CHAR(TO_DATE(season_end_day,'dd-mm-yyyy'),'dd mon yyyy')))
                INTO   g_vSummerOffShowDate,
                       g_vWinterOffShowDate,
                       g_vCTLOffShowDate
                FROM tar_season_end_day_cfg;
            EXCEPTION
                WHEN OTHERS THEN
                    -- 'Season End Day' Configuration is not found or incorrect
                    g_vSummerOffShowDate := LC_cZEROES;
                    g_vWinterOffShowDate := LC_cZEROES;
                    g_vCTLOffShowDate    := LC_cZEROES;
                    dbms_output.put_line('Season End Day configuration (tar_season_end_day_cfg) is not found or incorrect');
            END;
        END IF;

        IF g_vSummerOffShowDate <> LC_cZEROES THEN
            IF g_udaSeason.EXISTS(TRIM(p_cProductNumber)) THEN
                l_vAtrCode := TRIM(g_udaSeason(TRIM(p_cProductNumber)));
                IF l_vAtrCode = LC_vCTL THEN
                    l_vValue := g_vCTLOffShowDate;
                ELSE
                    l_cSeason := SUBSTR(l_vAtrCode,1,1);

                    SELECT regexp_replace(l_vAtrCode, '[^0-9]', '')
                    INTO   l_cYear
                    FROM   DUAL;

                    IF l_cSeason = LC_cSUMMER THEN
                        l_vValue := g_vSummerOffShowDate || LC_cTWENTY || l_cYear;
                    ELSIF l_cSeason = LC_cWINTER THEN
                        l_vValue := g_vWinterOffShowDate || LC_cTWENTY || l_cYear;
                    ELSE
                        l_vValue := NULL;
                    END IF;
                END IF;

                IF l_vValue IS NULL THEN
                    dbms_output.put_line('Invalid Product Life->Season attribute code for product ' || p_cProductNumber);
                ELSE
                    BEGIN
                        -- Ensure value is in Date format
                        l_dDate := TO_DATE(l_vValue);
                        INSERT INTO sdivalmsi(audit_number,
                                              tran_type,
                                              org_lvl_number,
                                              prd_lvl_number,
                                              pmg_po_number,
                                              pmg_line_number,
                                              pmg_dtl_tech_key,
                                              field_code,
                                              entity_name,
                                              VALUE,
                                              val_err_code,
                                              date_created,
                                              download_date_1,
                                              download_date_2)
                        SELECT audit_number.NEXTVAL,
                               LC_cRECORD_TYPE,
                               NULL,
                               p_cProductNumber,
                               NULL,
                               NULL,
                               NULL,
                               LC_cCODE_OFFSHOWDATE,
                               LC_vPRDMSTEE_ENTITY,
                               l_vValue,
                               NULL,
                               NULL,
                               NULL,
                               NULL
                        FROM   DUAL;
                    EXCEPTION
                        WHEN OTHERS THEN
                            -- Value is not in Date format
                            dbms_output.put_line('Invalid Off Show Date for product ' || p_cProductNumber);
                    END;
                END IF;
            ELSE
                dbms_output.put_line('Product Life->Season attribute code is not found for product ' || p_cProductNumber);
            END IF;
        END IF;

        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vend);

    END p_AddOffShowDate;

    /************************************************************************
    *
    * NAME:        p_XmlStyColProdRef
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This Procedure will associate every style/colour to a system generated
    *                       product for the product registration files received from GBSS system.
    *
    * USAGE:       p_XmlStyColProdRef(p_nSdiBatchNum)
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri       17/05/2013  Original Version.
    * Grant Whiteside   05/11/2013  Modify for Standards
    * Brett Rees        13/01/2014  Fixed previously registered products from having their product number overwritten
    * Brett Rees        17/01/2014  GM Product fixes
    * Nisa Basheer      17/06/2014  Added New flag 'no_var'to encoporate dummy dimension.
    * Nisa Basheer      28/04/2015  R3 Added logic for multiple APN.
    * Nisa Basheer      28/04/2015  R3 Added logic for multiple APN.
    * Nisa Basheer      18/06/2016  Added Call for Pack A validation.
    * Ronald Nava       05/07/2017  Modified XML query construct to improve performance
    * Ronald Nava       24/10/2017  Fixed aliases and cursor names.
    * Ronald Nava       16/01/2018  Fixed query to handle multiple APNs.
    * Ronald Nava       06/08/2018  Added exception handling for gbss_ref_no > 10 characters.
    * Ronald Nava       17/10/2023  SCR18813 - Comment out GBSS_REF_NO length validation
    * Cursor Agent      24/09/2026  Skip sty_prd insert when colour already exists for batch
    *                               (prevents triple product numbers on job rerun).
    *************************************************************************/

    PROCEDURE p_XmlStyColProdRef (p_nSdiBatchNum IN sdiprdati.batch_num%TYPE,
                                  p_cStatCode OUT CHAR) AS
        /* Local Declarations */

        LC_vPGMNAME        CONSTANT VARCHAR2(60)                      := 'tar_gbss_prd_file_loading.p_XmlStyColProdRef';

        l_iTotFilesCount            PLS_INTEGER                       :=0;
        l_vGbssRefNo                tar_gbss_sty_prd.gbss_ref_no%TYPE;
        l_vGbssRefNumber            tar_gbss_sty_prd.gbss_ref_no%TYPE;
        l_cProductNumber            prdmstee.prd_lvl_number%TYPE;
        l_nProductNumber8           NUMBER(1);
        l_nGbssRefNoLen             NUMBER;
        l_nVarErrorCode             NUMBER;
        l_vErrorMsg                 VARCHAR2(50);
        /* Cursors */
        CURSOR l_curStyNoPrdNum IS
            SELECT DISTINCT gbss_ref_no
            FROM   tar_gbss_sty_prd sp
            WHERE  product_number IS NULL
            AND    batch_num = p_nSdiBatchNum;

        CURSOR l_curCrePrdForCol(l_vGbssRefNo IN VARCHAR2) IS
            SELECT sty.colour_sequence,
                   ROWID
            FROM   tar_gbss_sty_prd sty
            WHERE  sty.gbss_ref_no            = l_vGbssRefNo
            AND    sty.product_number         IS NULL
            AND    sty.overall_prd_reg_status IS NULL
            AND    sty.batch_num              = p_nSdiBatchNum;

        l_eGbssRefNoLenVal EXCEPTION;

    BEGIN
        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vstart);

        INSERT INTO tar_gbss_sty_prd (batch_num,
                                      sender_id,
                                      date_time_send,
                                      message_seq,
                                      version,
                                      reference_no,
                                      item_style_no,
                                      gbss_ref_no,
                                      colour_sequence,
                                      filename,
                                      download_date,
                                      auto_apn,
                                      no_sizes,
                                      no_var
                                      )
                                     (SELECT fst.batch_num,
                                             xml.send_id,
                                             xml.date_time,
                                             xml.message_seq,
                                             xml.version,
                                             xml.reference_no,
                                             xml.item_style_no,
                                             xml.gbss_ref_number,
                                             xml.colour_sequence,
                                             fst.filename,
                                             SYSDATE,
                                             DECODE(COUNT(xml.apn_number),0, NULL, 1),
                                             DECODE(xml.size_template, NULL, GC_cTRUE, GC_cDUMMY_DIMENSION, GC_cTRUE, GC_cFALSE),
                                             DECODE(xml.size_template, GC_cDUMMY_DIMENSION, GC_cTRUE, GC_cFALSE)
                                      FROM   tar_gbss_prd_file_store fst,
                                             XMLTABLE('for $i in /Brief/Colour/ColourSize/APN
                                                       return <row>
                                                       {
                                                            <colour_sequence>{$i/../../@seq/string()}</colour_sequence>,
                                                            $i/../../../GBSSRefNo,
                                                            $i/../../../SizeTemplateName,
                                                            $i/../../../Header/ID,
                                                            $i/../../../Header/MessageSeq,
                                                            $i/../../../Header/RefNo,
                                                            $i/../../../Header/ItemStyleNo,
                                                            $i/../../../Header/DateTime,
                                                            $i/../../../Header/Version,
                                                            <apn_num>{$i/string()}</apn_num>,
                                                            $i/../Status
                                                       }
                                                       </row>'
                                                       PASSING fst.filecontent
                                                       COLUMNS
                                                               gbss_ref_number PATH 'GBSSRefNo',
                                                               size_template   PATH 'SizeTemplateName',
                                                               colour_sequence PATH 'colour_sequence',
                                                               send_id         PATH 'ID',
                                                               message_seq     PATH 'MessageSeq',
                                                               reference_no    PATH 'RefNo',
                                                               item_style_no   PATH 'ItemStyleNo',
                                                               date_time       PATH 'DateTime',
                                                               version         PATH 'Version',
                                                               apn_number      PATH 'apn_num',
                                                               size_status     PATH 'Status'
                                                     ) xml
                                      WHERE  fst.batch_num = p_nSdiBatchNum
                                      AND    xml.size_status = 'Active'
                                      AND    NOT EXISTS (
                                                 SELECT 1
                                                 FROM   tar_gbss_sty_prd sp
                                                 WHERE  sp.batch_num       = fst.batch_num
                                                 AND    sp.gbss_ref_no     = xml.gbss_ref_number
                                                 AND    sp.colour_sequence = xml.colour_sequence
                                             )
                                      GROUP BY  fst.batch_num,
                                                xml.send_id,
                                                xml.date_time,
                                                xml.message_seq,
                                                xml.version,
                                                xml.reference_no,
                                                xml.item_style_no,
                                                xml.gbss_ref_number,
                                                xml.colour_sequence,
                                                fst.filename,
                                                xml.size_template
                                     );

        /*BEGIN SCR18813
        SELECT DISTINCT LENGTH(gbss_ref_no),
               gbss_ref_no
        INTO   l_nGbssRefNoLen,
               l_vGbssRefNumber
        FROM   tar_gbss_sty_prd
        WHERE  product_number IS NULL
        AND    batch_num = p_nSdiBatchNum;

        IF    l_nGbssRefNoLen > 10
        THEN  RAISE l_eGbssRefNoLenVal;
        END IF;
        END SCR18813*/

        SELECT COUNT(DISTINCT gbss_ref_no)
        INTO   l_iTotFilesCount
        FROM   tar_gbss_sty_prd
        WHERE  product_number IS NULL
        AND    batch_num = p_nSdiBatchNum;

        dbms_output.put_line('The Total GBBS Files:  ' || l_iTotFilesCount);

        /* START LINKING PRODUCT NUMBERS TO EACH STYLE/COLOUR COMING FROM GBSS */
        FOR l_rowStyNoPrdNum IN l_curStyNoPrdNum LOOP
            FOR l_rowCrePrdForCol IN l_curCrePrdForCol(l_rowStyNoPrdNum.gbss_ref_no) LOOP
                bastkey('prd_lvl_number ',
                        0,
                        l_cProductNumber,
                        GC_cFALSE
                        );

                SELECT tarf_CheckDigit(TRIM(l_cProductNumber))
                INTO   l_nProductNumber8
                FROM   DUAL;

                UPDATE tar_gbss_sty_prd sty_prd
                SET    product_number           = TRIM(l_cProductNumber) || l_nProductNumber8
                WHERE  gbss_ref_no              = l_rowStyNoPrdNum.gbss_ref_no
                AND    colour_sequence          = l_rowCrePrdForCol.colour_sequence
                AND    sty_prd.rowid            = l_rowCrePrdForCol.rowid
                AND    batch_num                = p_nSdiBatchNum;

            END LOOP;
        END LOOP;

        /* Pack A validation */
        p_ValidatePackA(p_nSdiBatchNum);


        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vend);

        p_cStatCode := GC_cTRUE;

    EXCEPTION
        WHEN l_eGbssRefNoLenVal THEN
            l_nVarErrorCode := 903;
            l_vErrorMsg     :='GBSS_REF_NO is more than 10 characters.';
            p_cStatCode     := GC_cFALSE;
            INSERT INTO tar_gbss_prd_sdi_upld_rej(script_name,
                                                  gbss_ref_no,
                                                  product_number,
                                                  colour_sequence,
                                                  reason_code,
                                                  comment1,
                                                  comment2,
                                                  comment3,
                                                  error_date)
           VALUES(LC_vPGMNAME,
                  l_vGbssRefNumber,
                  NULL,
                  NULL,
                  l_nVarErrorCode,
                  l_vErrorMsg,
                  NULL,
                  NULL,
                  SYSDATE);

            UPDATE tar_gbss_sty_prd
            SET    overall_prd_reg_status = GC_cFALSE
            WHERE  product_number         IS NULL
            AND    batch_num              = p_nSdiBatchNum;

            COMMIT;

        WHEN OTHERS THEN
            RAISE_APPLICATION_ERROR(-20020,'Error in '|| LC_vPGMNAME ||': '||SQLCODE ||' - '|| SQLERRM);

    END p_XmlStyColProdRef;

    /************************************************************************
    *
    * NAME:        p_LoadAttributesToSdi
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This Procedure read the attributes from the XML FILE and load the data into SDIPRDATI TABLE
    *                       for every record that is not processed in the tar_gbss_sty_prd Table
    *
    * USAGE:      p_LoadAttributesToSdi
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri       17/05/2013  Original Version.
    * Grant Whiteside   06/11/2013  Modify for Standards
    * Brett Rees        07/01/2014  Cater for attributes containing an ampersand
    * Brett Rees        27/02/2014  Set prd_lvl_id to 1.
    * Nisa Basheer      15/12/2014  add SKU type Attribute
    * Ram Kornepati     30/12/2014  SCR13174 - Store 'Product Life' -> 'Season' attribute
    * Ronald Nava       05/07/2017  Modified XML query construct to improve performance
    * Ronald Nava       24/10/2017  Fixed aliases and cursor names.
    *************************************************************************/

    PROCEDURE p_LoadAttributesToSdi(p_nSdiBatchNum IN sdiprdati.batch_num%TYPE) AS
        /* Local Declarations */

        LC_vPGMNAME            CONSTANT VARCHAR2(60)                          := 'tar_gbss_prd_file_loading.p_LoadAttributesToSdi';
        LC_nATTR_COMB_WRONG    CONSTANT NUMBER(3)                             := 92;
        LC_vSUPPLY_CHAIN       CONSTANT VARCHAR2(15)                          := 'Supply Chain';
        LC_nSUPPLY_CHAIN_ERR   CONSTANT NUMBER(3)                             := 912;
        LC_cRECORD_TYPE        CONSTANT CHAR(1)                               := 'A';
        LC_cAPP_FUNC_PRD       CONSTANT basatyee.app_func%TYPE                := 'PRD';
        LC_nPRDLVLID_PRODUCT   CONSTANT sdiprdati.prd_lvl_id%TYPE             := 1;
        LC_vPRODUCT_LIFE       CONSTANT basatyee.atr_type_desc%TYPE           := 'Product Life';
        LC_vSEASON             CONSTANT basahree.atr_header_desc%TYPE         := 'Season';

        /* Force SKU type Attribute */
        LC_vSKU_TYPE               CONSTANT VARCHAR2(12)                      := 'SKU Type';
        LC_nSKU_TYPE_ERR           CONSTANT NUMBER(3)                         := 913;

        l_iRecCount                     PLS_INTEGER                           := 0;
        l_iBadCnt                       PLS_INTEGER                           := 0;
        l_vGbssRefNo                    tar_gbss_sty_prd.gbss_ref_no%TYPE;
        l_nColourSequence               tar_gbss_sty_prd.colour_sequence%TYPE;
        l_nAtrTypeTechKey               basatyee.atr_typ_tech_key%TYPE;
        l_vAtrTypeDesc                  basatyee.atr_type_desc%TYPE;
        l_nAtrHdrTechKey                basahree.atr_hdr_tech_key%TYPE;
        l_vAtrHeaderDesc                basahree.atr_header_desc%TYPE;
        l_cAtrCode                      basacdee.atr_code%TYPE;
        l_vAtrCode_desc                 basacdee.atr_code_desc%TYPE;
        l_nErrorCode                    sdicsirej.error_code%TYPE;
        l_iAttrCntNo                    PLS_INTEGER;
        l_cSCAtrCode                    basacdee.atr_code%TYPE;
        l_vSCAtrCodedesc                basacdee.atr_code_desc%TYPE;
        l_nSCAtrTypeTechKey             basatyee.atr_typ_tech_key%TYPE;

        /* CURSORs */
        CURSOR l_curGetRef IS
            SELECT DISTINCT gbss_ref_no
            FROM   tar_gbss_sty_prd
            WHERE  upload_date           IS NULL
            AND    upload_to_base        IS NULL
            AND    batch_num = p_nSdiBatchNum;

        /* extract the attributes from the incoming XML File */
        CURSOR l_curGetAttrFromFile IS
            SELECT DISTINCT xml.gbss_ref_no,
                   xml.colour_sequence,
                   sty.product_number,
                   REPLACE(xml.attribute_type,    CHR(38)||'amp;', CHR(38)) AS attribute_type,
                   REPLACE(xml.attribute_subtype, CHR(38)||'amp;', CHR(38)) AS attribute_subtype,
                   REPLACE(xml.attribute_code,    CHR(38)||'amp;', CHR(38)) AS attribute_code
            FROM   tar_gbss_prd_file_store xfs,
                   tar_gbss_sty_prd sty,
                   XMLTABLE('for $i in /Brief/Colour/Keycode/Attribute
                             return <row>
                             {
                                  $i/../../../GBSSRefNo,
                                  <colour_sequence>{$i/../../@seq/string()}</colour_sequence>,
                                  $i/Type,
                                  $i/SubType,
                                  $i/Code
                             }
                             </row>'
                             PASSING xfs.filecontent
                             COLUMNS gbss_ref_no       PATH 'GBSSRefNo',
                                     colour_sequence   PATH 'colour_sequence',
                                     attribute_type    PATH 'Type',
                                     attribute_subtype PATH 'SubType',
                                     attribute_code    PATH 'Code'
                           ) xml
            WHERE  xfs.batch_num             = p_nSdiBatchNum
            AND    xml.attribute_subtype    <> LC_vSUPPLY_CHAIN
            AND    xml.attribute_subtype    <> LC_vSKU_TYPE
            AND    xml.gbss_ref_no           = sty.gbss_ref_no
            AND    xml.colour_sequence       = sty.colour_sequence
            AND    sty.upload_date    IS NULL
            AND    sty.upload_to_base IS NULL;

        CURSOR l_curSupChainAttr IS
            SELECT DISTINCT xml.gbss_ref_no,
                   TRIM(xml.vendor_sap_number) sap_number,
                   sty.product_number,
                   xml.colour_sequence
            FROM   tar_gbss_prd_file_store xfs,
                   tar_gbss_sty_prd sty,
                   xmltable('for $i in /Brief/Colour
                             return <row>
                             {
                                  $i/../GBSSRefNo,
                                  $i/../VendorSAPNo,
                                  <colour_sequence>{$i/@seq/string()}</colour_sequence>
                             }
                             </row>'
                             PASSING xfs.filecontent
                             COLUMNS gbss_ref_no       path 'GBSSRefNo',
                                     vendor_sap_number path 'VendorSAPNo',
                                     colour_sequence   PATH 'colour_sequence'
                           ) xml
            WHERE xfs.batch_num       = p_nSdiBatchNum
            AND   xml.gbss_ref_no     = sty.gbss_ref_no
            AND   xml.colour_sequence = sty.colour_sequence
            AND   sty.upload_date    IS NULL
            AND   sty.upload_to_base IS NULL;

        /* Force SKU type Attribute */
        CURSOR l_curSkuType IS
            SELECT DISTINCT (xml.product_type) AS sku_type,
                   sty.prd_lvl_child,
                   sty.product_number,
                   xml.gbss_ref_no,
                   xml.colour_sequence
            FROM   tar_gbss_prd_file_store xfs,
                   tar_gbss_sty_prd        sty,
                   XMLTABLE('for $i in /Brief/Colour
                             return <row>
                             {
                                  $i/../GBSSRefNo,
                                  <colour_sequence>{$i/@seq/string()}</colour_sequence>,
                                  $i/Keycode/ProductType
                             }
                             </row>'
                             PASSING xfs.filecontent
                             COLUMNS gbss_ref_no     PATH 'GBSSRefNo',
                                     colour_sequence PATH 'colour_sequence',
                                     product_type    PATH 'ProductType'
                           ) xml
            WHERE  xfs.batch_num       = p_nSdiBatchNum
            AND    xml.gbss_ref_no     = sty.gbss_ref_no
            AND    xml.colour_sequence = sty.colour_sequence
            AND    sty.upload_date    IS NULL
            AND    sty.upload_to_base IS NULL;


    BEGIN

        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vstart);

        FOR l_rowGetRef IN l_curGetRef LOOP
            l_iRecCount := l_iRecCount + 1;
        END LOOP;

        IF l_iRecCount > 0 THEN
            dbms_output.put_line('Styles available to process.');
        ELSE
            dbms_output.put_line('No style to process');
            RETURN;
        END IF;

        /* Extract tech keys etc for the combination of the fields extracted in cursor above for attributes */
        FOR l_rowGetAttrFromFile IN l_curGetAttrFromFile LOOP
            BEGIN
                SELECT typ.atr_typ_tech_key,
                       typ.atr_type_desc,
                       hdr.atr_hdr_tech_key,
                       hdr.atr_header_desc,
                       cde.atr_code,
                       cde.atr_code_desc
                INTO   l_nAtrTypeTechKey,
                       l_vAtrTypeDesc,
                       l_nAtrHdrTechKey,
                       l_vAtrHeaderDesc,
                       l_cAtrCode,
                       l_vAtrCode_desc
                FROM   basatyee typ,
                       basahree hdr,
                       basacdee cde
                WHERE  typ.app_func              = LC_cAPP_FUNC_PRD
                AND    hdr.atr_typ_tech_key      = typ.atr_typ_tech_key
                AND    cde.atr_hdr_tech_key      = hdr.atr_hdr_tech_key
                AND    TRIM(typ.atr_type_desc)   = TRIM(l_rowGetAttrFromFile.attribute_type)
                AND    TRIM(hdr.atr_header_desc) = TRIM(l_rowGetAttrFromFile.attribute_subtype)
                AND    TRIM(cde.atr_code_desc)   = TRIM(l_rowGetAttrFromFile.attribute_code);

            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    l_nErrorCode := LC_nATTR_COMB_WRONG;
                    INSERT INTO tar_gbss_prd_sdi_upld_rej
                           (script_name ,
                            gbss_ref_no,
                            product_number,
                            colour_sequence,
                            reason_code,
                            comment1,
                            comment2,
                            comment3,
                            error_date
                           )
                    VALUES
                           (LC_vPGMNAME,
                            l_rowGetAttrFromFile.gbss_ref_no,
                            l_rowGetAttrFromFile.product_number,
                            l_rowGetAttrFromFile.colour_sequence,
                            l_nErrorCode,
                            'Attr. code ' || l_rowGetAttrFromFile.attribute_type || ' | ' || l_rowGetAttrFromFile.attribute_subtype || ' | ' || l_rowGetAttrFromFile.attribute_code || ' does not exist',
                            NULL,
                            NULL,
                            SYSDATE
                            );
            END;

            /* Insert into the SDI table sdiprdati for all the attributes */

            SELECT tar_gbss_attr_cnt_seq.NEXTVAL
            INTO   l_iAttrCntNo
            FROM   dual;

            INSERT INTO sdiprdati(batch_num,
                                  control_number,
                                  prd_lvl_number,
                                  org_lvl_number,
                                  atr_typ_tech_key,
                                  atr_type_desc,
                                  atr_hdr_tech_key,
                                  atr_hdr_desc,
                                  atr_code,
                                  tran_type,
                                  atr_code_desc,
                                  att_create,
                                  prd_lvl_id,
                                  org_lvl_id,
                                  date_created,
                                  download_date_1,
                                  download_date_2,
                                  atr_is_value,
                                  ERROR_CODE,
                                  prd_lvl_child)
            VALUES(p_nSdiBatchNum,
                   l_iAttrCntNo,
                   l_rowGetAttrFromFile.product_number,
                   NULL,
                   l_nAtrTypeTechKey,
                   l_vAtrTypeDesc,
                   l_nAtrHdrTechKey,
                   l_vAtrHeaderDesc,
                   l_cAtrCode,
                   LC_cRECORD_TYPE,
                   l_vAtrCode_desc,
                   NULL,
                   LC_nPRDLVLID_PRODUCT,
                   NULL,
                   NULL,
                   NULL,
                   NULL,
                   NULL,
                   NULL,
                   NULL
                  );

            -- If attribute is 'Product Life' -> 'Season', save the attribute code
            IF l_vAtrTypeDesc = LC_vPRODUCT_LIFE
            AND l_vAtrHeaderDesc = LC_vSEASON THEN
                g_udaSeason(TRIM(l_rowGetAttrFromFile.product_number)) := l_cAtrCode;
            END IF;

        END LOOP;

        /* supplychain supplychain attribute */
        FOR l_rowSupChainAttr IN l_curSupChainAttr LOOP
            BEGIN

                SELECT tar_gbss_attr_cnt_seq.NEXTVAL,
                       typ.atr_typ_tech_key,
                       hdr.atr_hdr_tech_key,
                       cde.atr_code,
                       cde.atr_code_desc
                INTO   l_iAttrCntNo,
                       l_nSCAtrTypeTechKey,
                       l_nAtrHdrTechKey,
                       l_cSCAtrCode,
                       l_vSCAtrCodedesc
                FROM   basatyee  typ,
                       basahree  hdr,
                       basacdee  cde
                WHERE  cde.atr_code         = RPAD(TRIM(l_rowSupChainAttr.sap_number), 10, ' ')
                AND    cde.atr_hdr_tech_key = hdr.atr_hdr_tech_key
                AND    hdr.atr_header_desc  = LC_vSUPPLY_CHAIN
                AND    hdr.atr_typ_tech_key = typ.atr_typ_tech_key
                AND    typ.atr_type_desc    = LC_vSUPPLY_CHAIN;

                INSERT INTO sdiprdati(batch_num,
                                      control_number,
                                      prd_lvl_number,
                                      org_lvl_number,
                                      atr_typ_tech_key,
                                      atr_type_desc,
                                      atr_hdr_tech_key,
                                      atr_hdr_desc,
                                      atr_code,
                                      tran_type,
                                      atr_code_desc,
                                      att_create,
                                      prd_lvl_id,
                                      org_lvl_id,
                                      date_created,
                                      download_date_1,
                                      download_date_2,
                                      atr_is_value,
                                      ERROR_CODE,
                                      prd_lvl_child)
                VALUES(p_nSdiBatchNum,
                       l_iAttrCntNo,
                       l_rowSupChainAttr.product_number,
                       NULL,
                       l_nSCAtrTypeTechKey,
                       LC_vSUPPLY_CHAIN,
                       l_nAtrHdrTechKey,
                       LC_vSUPPLY_CHAIN,
                       l_cSCAtrCode,
                       LC_cRECORD_TYPE,
                       l_vSCAtrCodedesc,
                       NULL,
                       LC_nPRDLVLID_PRODUCT,
                       NULL,
                       NULL,
                       NULL,
                       NULL,
                       NULL,
                       NULL,
                       NULL
                      );
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    INSERT INTO tar_gbss_prd_sdi_upld_rej(script_name,
                                                          gbss_ref_no,
                                                          colour_sequence,
                                                          reason_code,
                                                          comment1
                                                          )
                VALUES(LC_vPGMNAME,
                       l_rowSupChainAttr.gbss_ref_no,
                       l_rowSupChainAttr.colour_sequence,
                       LC_nSUPPLY_CHAIN_ERR,
                       'Vendor attribute not set'
                      );
            END;
        END LOOP;

        /* SKU type attribute*/
        FOR l_rowSKUAttr IN l_curSkuType LOOP
            BEGIN

                SELECT tar_gbss_attr_cnt_seq.NEXTVAL,
                       typ.atr_typ_tech_key,
                       hdr.atr_hdr_tech_key,
                       cde.atr_code,
                       cde.atr_code_desc
                INTO   l_iAttrCntNo,
                       l_nSCAtrTypeTechKey,
                       l_nAtrHdrTechKey,
                       l_cSCAtrCode,
                       l_vSCAtrCodedesc
                FROM   basatyee  typ,
                       basahree  hdr,
                       basacdee  cde
                WHERE  cde.atr_code         = RPAD(TRIM(l_rowSKUAttr.sku_type), 10, ' ')
                AND    cde.atr_hdr_tech_key = hdr.atr_hdr_tech_key
                AND    hdr.atr_header_desc  = LC_vSKU_TYPE
                AND    hdr.atr_typ_tech_key = typ.atr_typ_tech_key
                AND    typ.atr_type_desc    = LC_vSKU_TYPE;

                INSERT INTO sdiprdati(batch_num,
                                      control_number,
                                      prd_lvl_number,
                                      org_lvl_number,
                                      atr_typ_tech_key,
                                      atr_type_desc,
                                      atr_hdr_tech_key,
                                      atr_hdr_desc,
                                      atr_code,
                                      tran_type,
                                      atr_code_desc,
                                      att_create,
                                      prd_lvl_id,
                                      org_lvl_id,
                                      date_created,
                                      download_date_1,
                                      download_date_2,
                                      atr_is_value,
                                      ERROR_CODE,
                                      prd_lvl_child)
                VALUES(p_nSdiBatchNum,
                       l_iAttrCntNo,
                       l_rowSKUAttr.product_number,
                       NULL,
                       l_nSCAtrTypeTechKey,
                       LC_vSKU_TYPE,
                       l_nAtrHdrTechKey,
                       LC_vSKU_TYPE,
                       l_cSCAtrCode,
                       LC_cRECORD_TYPE,
                       l_vSCAtrCodedesc,
                       NULL,
                       LC_nPRDLVLID_PRODUCT,
                       NULL,
                       NULL,
                       NULL,
                       NULL,
                       NULL,
                       NULL,
                       NULL
                      );
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    INSERT INTO tar_gbss_prd_sdi_upld_rej(script_name,
                                                          gbss_ref_no,
                                                          colour_sequence,
                                                          reason_code,
                                                          comment1
                                                          )
                VALUES(LC_vPGMNAME,
                       l_rowSKUAttr.gbss_ref_no,
                       l_rowSKUAttr.colour_sequence,
                       LC_nSKU_TYPE_ERR,
                       'SKU Type attribute is not set'
                      );
            END;
        END LOOP;

        COMMIT;

        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vend);

    END p_LoadAttributesToSdi;

    /************************************************************************
    *
    * NAME:        p_LoadQtyToStaging
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This Procedure reads the XML fileand does the below 2
    *                       1.Extracts the casepack information at Product level and uploads them
    *                          into the SDI layer for registration the table is SDIVPCCSI
    *                       2. Read'ss the variation qty for each case pack and feeds them to the
    *                           Staging table to be eventually used by product_variation_qty package
    *
    * USAGE:      p_LoadVarQtyToStaging
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri        17/05/2013   Original Version.
    * Grant Whiteside    05/11/2013   Modify for Standards
    * Brett Rees         17/01/2014   GM Product fixes
    * Brett Rees         04/04/2013   Multiply cost received by gbss together with case qty
    * Nisa Basheer       23/05/2013   Enforced dimesion for App products
    * Nisa Basheer       30/07/2013   Colour level costing ( CR16B)
    * Nisa Basheer       01/12/2014   Invalid dimension SCR13078
    * Nisa Basheer       17-02-2016   Case Pack Redesign CR191
    * Ronald Nava        09/08/2017   Modified XML query construct to improve performance
    * Ronald Nava        24/10/2017   Fixed aliases and cursor names.
    *************************************************************************/
    PROCEDURE p_LoadQtyToStaging(p_nSdiBatchNum IN sdivpccsi.batch_num%TYPE) IS
        /* Local Declarations */

        LC_vPGMNAME           CONSTANT  VARCHAR2(60)                := 'tar_gbss_prd_file_loading.p_LoadVarQtyToStaging';
        LC_nDIMENSION_WRONG   CONSTANT  NUMBER(3)                   := 140;
        LC_cRECORD_TYPE       CONSTANT  CHAR(1)                     := 'A';
        LC_cGBSS_CASE_A       CONSTANT  CHAR(1)                     := 'A';
        LC_cCASE_UOM_EA       CONSTANT  CHAR(2)                     := 'EA';

        l_iRecCount                     PLS_INTEGER                 := 0;
        l_cPrdPddCode                   prddmdee.prd_pdd_code%TYPE;
        l_nTechKey                      sdivpccsi.tech_key%TYPE;
        l_cCasePackId                   sdivpccsi.case_pack_id%TYPE;
        l_vGbssRefNo                    tar_gbss_sty_prd.gbss_ref_no%TYPE;
        l_nColourSequence               tar_gbss_sty_prd.colour_sequence%TYPE;
        l_nErrorCode                    sdicsirej.error_code%TYPE;
        l_dtCalDate                     caldayee.caldat%TYPE;


        /* Main Cursor */
        CURSOR l_curGetRef IS
            SELECT DISTINCT gbss_ref_no
            FROM   tar_gbss_sty_prd
            WHERE  upload_date    IS NULL
            AND    upload_to_base IS NULL
            AND    batch_num = p_nSdiBatchNum;

        /* Cursor at case pack level */
        CURSOR l_curColCaseQty(l_vGbssRefNo      IN VARCHAR2) IS
            SELECT gbss_ref_no,
                   colour_sequence,
                   product_number,
                   case_qty,
                   case_min_qty,
                   vendor_sap_number,
                   gbss_case_id,
                   est_lnd_cst_ex_gst * case_qty AS est_lnd_cst_ex_gst
            FROM   (SELECT DISTINCT xml.gbss_ref_no,
                           xml.est_lnd_cst_ex_gst,
                           xml.colour_sequence,
                           xml.case_qty,
                           xml.case_min_qty,
                           xml.vendor_sap_number,
                           xml.packtype gbss_case_id,
                           sty.product_number
                    FROM   tar_gbss_prd_file_store xfs,
                           tar_gbss_sty_prd sty,
                           XMLTABLE('for $i in /Brief/Colour/Pack
                                     return <row>
                                     {
                                          $i/../../GBSSRefNo,
                                          <colour_sequence>{$i/../@seq/string()}</colour_sequence>,
                                          $i/../EstELCAUD,
                                          $i/PackQty,
                                          $i/PackMinQty,
                                          $i/../../VendorSAPNo,
                                          <packtype>{$i/@type/string()}</packtype>
                                     }
                                     </row>'
                                     PASSING xfs.filecontent
                                     COLUMNS gbss_ref_no        PATH 'GBSSRefNo',
                                             colour_sequence    PATH 'colour_sequence',
                                             est_lnd_cst_ex_gst PATH 'EstELCAUD',
                                             case_qty           PATH 'PackQty',
                                             case_min_qty       PATH 'PackMinQty',
                                             vendor_sap_number  PATH 'VendorSAPNo',
                                             packtype           PATH 'packtype'
                                   ) xml
                    WHERE xfs.batch_num       = p_nSdiBatchNum
                    AND   xml.gbss_ref_no     = l_vGbssRefNo
                    AND   xml.gbss_ref_no     = sty.gbss_ref_no
                    AND   xml.colour_sequence = sty.colour_sequence
                    AND   xfs.batch_num       = sty.batch_num
                    )
            WHERE  NVL(case_qty,0)      > 0
            AND    NVL(case_min_qty, 0) > 0
            ORDER  BY gbss_case_id;

        /* CURSOR at variation level */
        CURSOR l_curVarQtyAtCaseLvl(l_vGbssRefNo      IN VARCHAR2) IS
            SELECT c_pack.gbss_ref_no,
                   c_pack.colour_sequence,
                   c_pack.product_number,
                   c_pack.case_qty,
                   c_pack.gbss_case_id,
                   c_pack.dimension_name,
                   c_pack.tech_key,
                   cs_pack.prd_pdd_name,
                   cs_pack.size_seq,
                   cs_pack.vpacktype,
                   cs_pack.var_qty
            FROM (SELECT gbss_ref_no,
                         colour_sequence,
                         product_number,
                         case_qty,
                         gbss_case_id,
                         dimension_name,
                         tech_key
                  FROM   (SELECT DISTINCT xml.gbss_ref_no,
                                 xml.colour_sequence,
                                 sty.product_number,
                                 xml.case_qty case_qty,
                                 xml.packtype gbss_case_id,
                                 xml.dimension_name,
                                 sdi.tech_key
                          FROM   tar_gbss_prd_file_store xfs,
                                 tar_gbss_sty_prd sty,
                                 sdivpccsi sdi,
                                 XMLTABLE('for $i in /Brief/Colour/Pack
                                           return <row>
                                           {
                                                $i/../../GBSSRefNo,
                                                $i/../../SizeTemplateName,
                                                <colour_sequence>{$i/../@seq/string()}</colour_sequence>,
                                                <packtype>{$i/@type/string()}</packtype>,
                                                $i/PackQty
                                           }
                                           </row>'
                                           PASSING xfs.filecontent
                                           COLUMNS gbss_ref_no     PATH 'GBSSRefNo',
                                                   dimension_name  PATH 'SizeTemplateName',
                                                   colour_sequence PATH 'colour_sequence',
                                                   packtype        PATH 'packtype',
                                                   case_qty        PATH 'PackQty') xml
                          WHERE xfs.batch_num       = p_nSdiBatchNum
                          AND   xml.gbss_ref_no     = l_vGbssRefNo
                          AND   xml.gbss_ref_no     = sty.gbss_ref_no
                          AND   xml.colour_sequence = sty.colour_sequence
                          AND   xfs.batch_num       = TO_CHAR(sty.batch_num)
                          AND   sty.batch_num       = sdi.batch_num
                          AND   sty.product_number  = sdi.prd_lvl_number
                          AND   xml.packtype        = SUBSTR(TRIM(sdi.case_pack_id),-1,1)
                         )
                  WHERE  case_qty        IS NOT NULL
                 ) c_pack,
                 (SELECT gbss_ref_no,
                         colour_sequence,
                         prd_pdd_name,
                         size_seq,
                         vpacktype,
                         var_qty
                  FROM   (SELECT DISTINCT xml.gbss_ref_no,
                                 xml.colour_sequence,
                                 xml.prd_pdd_name,
                                 xml.size_seq,
                                 xml.vpacktype,
                                 xml.var_qty
                          FROM   tar_gbss_prd_file_store xfs,
                                 XMLTABLE('for $i in /Brief/Colour/ColourSize/Pack
                                           return <row>
                                           {
                                                $i/../../../GBSSRefNo,
                                                <colour_sequence>{$i/../../@seq/string()}</colour_sequence>,
                                                <prd_pdd_name>{$i/../@code/string()}</prd_pdd_name>,
                                                $i/../SizeSeq,
                                                <vpacktype>{$i/@type/string()}</vpacktype>,
                                                $i/PackQty
                                           }
                                           </row>'
                                           PASSING xfs.filecontent
                                           COLUMNS gbss_ref_no     PATH 'GBSSRefNo',
                                                   colour_sequence PATH 'colour_sequence',
                                                   prd_pdd_name    PATH 'prd_pdd_name',
                                                   size_seq        PATH 'SizeSeq',
                                                   vpacktype       PATH 'vpacktype',
                                                   var_qty         PATH 'PackQty') xml
                          WHERE xfs.batch_num       = p_nSdiBatchNum
                          AND   xml.gbss_ref_no     = l_vGbssRefNo
                         )
                  WHERE var_qty IS NOT NULL
                 ) cs_pack
            WHERE c_pack.gbss_ref_no = cs_pack.gbss_ref_no
            AND c_pack.colour_sequence = cs_pack.colour_sequence
            AND c_pack.gbss_case_id = cs_pack.vpacktype
            ORDER  BY c_pack.gbss_ref_no,
                      c_pack.colour_sequence;

    BEGIN
        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vstart);

        /* Select Caldatee for case pack activation date */
        SELECT caldat
        INTO   l_dtCalDate
        FROM   caldayee;

        FOR l_rowGetRefCnt IN l_curGetRef LOOP
            l_iRecCount := l_iRecCount + 1;
        END LOOP;

        IF l_iRecCount > 0 THEN
            dbms_output.put_line('Style available to process');
        ELSE
            dbms_output.put_line('No styles to process');
            RETURN;
        END IF;

        FOR l_rowGetRef IN l_curGetRef LOOP
            FOR l_recColQty IN l_curColCaseQty(l_rowGetRef.gbss_ref_no) LOOP

                BEGIN

                    SELECT tech_key.NEXTVAL
                    INTO   l_nTechKey
                    FROM   dual;

                    IF LENGTH(l_recColQty.case_qty) > 2 THEN
                        l_cCasePackId  := TRIM(l_recColQty.product_number) ||
                                          TRIM(l_recColQty.case_qty) ||
                                          TRIM(l_recColQty.gbss_case_id);
                    ELSE
                        l_cCasePackId  := TRIM(l_recColQty.product_number) || '*' ||
                                          TRIM(l_recColQty.case_qty) ||
                                          TRIM(l_recColQty.gbss_case_id);
                    END IF;

                    INSERT INTO sdivpccsi (batch_num,
                                           tech_key,
                                           tran_type,
                                           prd_lvl_number,
                                           case_pack_id,
                                           vendor_number,
                                           vpc_prd_cost,
                                           vpc_case_qty,
                                           vpc_case_std_pack,
                                           vpc_cst_start,
                                           vpc_cst_end,
                                           case_pack_desc,
                                           date_created,
                                           download_date_1,
                                           download_date_2,
                                           prd_sll_uom)
                    VALUES(p_nSdiBatchNum,
                           l_nTechKey,
                           LC_cRECORD_TYPE,
                           l_recColQty.product_number,
                           l_cCasePackId,
                           l_recColQty.vendor_sap_number,
                           l_recColQty.est_lnd_cst_ex_gst,
                           l_recColQty.case_qty,
                           l_recColQty.case_min_qty,
                           l_dtCalDate,
                           GC_dtEND_DATE_DFLT,
                           NULL,
                           NULL,
                           NULL,
                           NULL,
                           l_recColQty.case_qty || LC_cCASE_UOM_EA);

                END;
            END LOOP;

            COMMIT;

            FOR l_rowVarQty IN l_curVarQtyAtCaseLvl(l_rowGetRef.gbss_ref_no) LOOP
                BEGIN

                    IF l_rowVarQty.dimension_name IS NOT NULL AND l_rowVarQty.dimension_name != GC_cDUMMY_DIMENSION THEN

                        BEGIN

                            SELECT dmd.prd_pdd_code
                            INTO   l_cPrdPddCode
                            FROM   prddmdee dmd,
                                   prddmhee dmh,
                                   basacdee acd
                            WHERE  dmd.prd_pdh_key        = dmh.prd_pdh_key
                            AND    dmh.prd_pdh_name       = RPAD(TRIM(l_rowVarQty.dimension_name), 30, ' ')
                            AND    dmd.prd_pdd_code       = RPAD(TRIM(l_rowVarQty.prd_pdd_name), 6, ' ')
                            AND    dmh.atr_hdr_tech_key   = acd.atr_hdr_tech_key
                            AND    dmd.atr_cod_tech_key   = acd.atr_cod_tech_key;

                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                l_nErrorCode := LC_nDIMENSION_WRONG;
                                  INSERT INTO tar_gbss_prd_sdi_upld_rej (script_name ,
                                                                         gbss_ref_no,
                                                                         product_number,
                                                                         colour_sequence,
                                                                         reason_code,
                                                                         comment1,
                                                                         comment2,
                                                                         comment3,
                                                                         error_date
                                                                        )
                                  VALUES(LC_vPGMNAME,
                                         l_rowGetRef.gbss_ref_no,
                                         l_rowVarQty.product_number,
                                         l_rowVarQty.colour_sequence,
                                         l_nErrorCode,
                                         'Invalid Dimension Used',
                                         NULL,
                                         NULL,
                                         SYSDATE
                                        );

                        END;

                        INSERT INTO tar_gbss_prd_var_qty(batch_num,
                                                         gbss_ref_no,
                                                         product_number,
                                                         prd_pdd_name,
                                                         qty,
                                                         seq,
                                                         dimension_name,
                                                         sdi_tech_key,
                                                         gbss_case_id,
                                                         vpc_prd_tech_key
                                                        )
                        VALUES(p_nSdiBatchNum,
                               l_rowGetRef.gbss_ref_no,
                               l_rowVarQty.product_number,
                               l_rowVarQty.prd_pdd_name,
                               l_rowVarQty.var_qty,
                               l_rowVarQty.size_seq,
                               l_rowVarQty.dimension_name,
                               l_rowVarQty.tech_key,
                               l_rowVarQty.gbss_case_id,
                               NULL
                              );
                    END IF;

                    IF l_rowVarQty.dimension_name IS NULL OR l_rowVarQty.dimension_name = GC_cDUMMY_DIMENSION THEN

                        /* We still need the size sequence number for non variation products (Should usually be 1 but can be different)*/
                        INSERT INTO tar_gbss_prd_var_qty(batch_num,
                                                         gbss_ref_no,
                                                         product_number,
                                                         prd_pdd_name,
                                                         qty,
                                                         seq,
                                                         dimension_name,
                                                         sdi_tech_key,
                                                         gbss_case_id,
                                                         vpc_prd_tech_key
                                                        )
                        VALUES(p_nSdiBatchNum,
                               l_rowGetRef.gbss_ref_no,
                               l_rowVarQty.product_number,
                               NULL,
                               l_rowVarQty.var_qty,
                               l_rowVarQty.size_seq,
                               DECODE(l_rowVarQty.dimension_name, GC_cDUMMY_DIMENSION, GC_cDUMMY_DIMENSION, NULL),
                               l_rowVarQty.tech_key,
                               l_rowVarQty.gbss_case_id,
                               NULL
                              );

                    END IF;
                END;
            END LOOP;

            COMMIT;

        END LOOP;
        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vend);

    END p_LoadQtyToStaging;


    /************************************************************************
    *
    * NAME:        p_LoadPrcToSdi
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This Procedure read's the pricing from the XML file and loads it into the
    *              SDI table prdprcee to create regular retail price
    *
    * USAGE:      p_LoadPrcToSdi
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri       17/05/2013  Original Version.
    * Grant Whiteside   05/11/2013  Modify for Standards
    * Nisa Basheer      30/07/2014  Modified to include colour level costing.
    * Nisa Basheer      17-02-2016  Case Pack Redesign CR191
    * Ronald Nava       12/07/2017  Modified XML query construct to improve performance
    * Ronald Nava       24/10/2017  Fixed indentation, fixed aliases and cursor names.
    *************************************************************************/
    PROCEDURE p_LoadPrcToSdi(p_nSdiBatchNum IN prdprcee.batch_num%TYPE) IS
        /* Local Declarations */

        LC_vPGMNAME           CONSTANT   VARCHAR2(60) := 'tar_gbss_prd_file_loading.p_LoadPrcToSdi';
        LC_vCURRENCY          CONSTANT   VARCHAR(3)   := 'AUD';
        LC_cRECORD_TYPE       CONSTANT   CHAR(1)      := 'A';
        LC_nINVALID_VENDOR_NO CONSTANT   NUMBER(3)    := 50;

        l_iRecCount                      PLS_INTEGER  := 0;
        l_iVendorExist                   PLS_INTEGER;
        l_dtCalDate                      caldayee.caldat%TYPE;
        l_vGbssRefNo                     tar_gbss_sty_prd.gbss_ref_no%TYPE;
        l_nColourSequence                tar_gbss_sty_prd.colour_sequence%TYPE;
        l_nErrorCode                     sdicsirej.error_code%TYPE;

        /* Exceptions */

        L_xVALIDATION_ERROR EXCEPTION;

        /* CURSOR's */

        /* Main Cursor */
        CURSOR l_curGetRefColour IS
            SELECT gbss_ref_no,
                   colour_sequence,
                   product_number
            FROM   tar_gbss_sty_prd
            WHERE  upload_date IS NULL
            AND    upload_to_base IS NULL
            AND    batch_num = p_nSdiBatchNum;

         /* Cursor to extract the sell price from Prod XML file */

        CURSOR l_curGetPrc(l_vGbssRefNo      IN VARCHAR2,
                           l_nColourSequence IN NUMBER) IS
            SELECT xml.gbss_ref_no,
                   xml.vendor_sap_number,
                   xml.prc_inc_gst,
                   xml.colour_sequence
            FROM   tar_gbss_prd_file_store xfs,
                   XMLTABLE('for $i in /Brief/Colour
                             return <row>
                             {
                                  $i/../GBSSRefNo,
                                  $i/../VendorSAPNo,
                                  $i/EstSellPriceAUDIncGST,
                                  <colour_sequence>{$i/@seq/string()}</colour_sequence>
                             }
                             </row>'
                             PASSING xfs.filecontent
                             COLUMNS gbss_ref_no       PATH 'GBSSRefNo',
                                     vendor_sap_number PATH 'VendorSAPNo',
                                     colour_sequence   PATH 'colour_sequence',
                                     prc_inc_gst       PATH 'EstSellPriceAUDIncGST'
                           ) xml
            WHERE  xml.gbss_ref_no      = l_vGbssRefNo
            AND    xml.colour_sequence  = l_nColourSequence
            AND    xfs.batch_num        = p_nSdiBatchNum;

         /* Cursor to get all valid ca chain Id's */
         CURSOR l_curCapChain IS
             SELECT cap_chain_id
             FROM   csttypee cty
             WHERE  cty.cst_type_default = GC_cTRUE;

    BEGIN
        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vstart);
        /* Calculate cal date fo price event */
        SELECT caldat
        INTO   l_dtCalDate
        FROM   caldayee;

        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vstart);

        FOR l_rowGetCnt IN l_curGetRefColour LOOP
            l_iRecCount := l_iRecCount + 1;
        END LOOP;

        IF l_iRecCount > 0 THEN
           dbms_output.put_line('Style available to process');
        ELSE
           dbms_output.put_line('No styles to process');
           RETURN;
        END IF;
        FOR l_rowRefCol IN l_curGetRefColour LOOP
            BEGIN
                FOR l_rowPrcV IN l_curGetPrc(l_rowRefCol.gbss_ref_no,
                                             l_rowRefCol.colour_sequence) LOOP
                    BEGIN
                        SELECT 1
                        INTO   l_iVendorExist
                        FROM   vpcmstee vms
                        WHERE  vms.vendor_number = RPAD(TRIM(l_rowPrcV.vendor_sap_number), 10, ' ');
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            NULL;
                            l_nErrorCode := LC_nINVALID_VENDOR_NO;
                            RAISE L_xVALIDATION_ERROR;
                    END;
                END LOOP;
                FOR l_rowPrc IN l_curGetPrc(l_rowRefCol.gbss_ref_no,
                                            l_rowRefCol.colour_sequence) LOOP
                    BEGIN
                        FOR l_rowCapChain IN l_curCapChain LOOP
                            BEGIN
                                /* start inserting into the prdprcee for the combo */
                                INSERT INTO prdprcee (batch_num,
                                                      cap_chain_id,
                                                      record_type,
                                                      prc_type,
                                                      org_lvl_child,
                                                      org_lvl_number,
                                                      prd_lvl_child,
                                                      prd_lvl_number,
                                                      prc_zone_id,
                                                      prc_zone_number,
                                                      curr_code,
                                                      prd_eff_date,
                                                      prd_to_date,
                                                      prd_prc_mult,
                                                      prd_prc_price,
                                                      proc_by_price,
                                                      default_curr,
                                                      apply_curr_conv,
                                                      apply_round,
                                                      prd_prc_price_vatexc
                                                     )
                                VALUES(p_nSdiBatchNum,
                                       l_rowCapChain.cap_chain_id,
                                       LC_cRECORD_TYPE,
                                       1,
                                       GC_nZERO,
                                       GC_nZERO,
                                       GC_nZERO,
                                       l_rowRefCol.product_number,
                                       GC_nZERO,
                                       GC_nZERO,
                                       LC_vCURRENCY,
                                       l_dtCalDate,
                                       GC_dtEND_DATE_DFLT,
                                       1,
                                       l_rowPrc.prc_inc_gst,
                                       GC_cFALSE,
                                       GC_cTRUE,
                                       NULL,
                                       NULL,
                                       NULL
                                       );
                            END;
                        END LOOP; /*END CAP CHAIN LOOP */
                    END;
                END LOOP; /*END COLOUR LOOP */
            EXCEPTION
                WHEN L_xVALIDATION_ERROR THEN
                    BEGIN
                        INSERT INTO tar_gbss_prd_sdi_upld_rej (script_name,
                                                               gbss_ref_no,
                                                               product_number,
                                                               colour_sequence,
                                                               reason_code,
                                                               comment1,
                                                               comment2,
                                                               comment3,
                                                               error_date
                                                               )
                        VALUES(LC_vPGMNAME,
                               l_rowRefCol.gbss_ref_no,
                               l_rowRefCol.product_number,
                               l_rowRefCol.colour_sequence,
                               l_nErrorCode,
                               'Invalid Vendor Number',
                               NULL,
                               NULL,
                               SYSDATE
                               );
                    END;
                WHEN OTHERS THEN
                    ROLLBACK WORK;
                    RAISE;
            END;
        END LOOP;

        COMMIT;

        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vend);

    END p_LoadPrcToSdi;


    /************************************************************************
    *
    * NAME:        p_LoadDescToSdi
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This Procedure read's the Description from the XML file and loads it into the
    *              SDI table sdiprddsi to create description.
    *
    * USAGE:      p_LoadDescToSdi
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri       17/05/2013  Original Version.
    * Grant Whiteside   06/11/2013  Modify for Standards
    * Ronald Nava       12/07/2017  Modified XML query construct to improve performance
    * Ronald Nava       24/10/2017  Fixed aliases and cursor names.
    * Ronald Nava       03/06/2019  Added bug fix to address Oracle unpivot bug 14641856
    *************************************************************************/
    PROCEDURE p_LoadDescToSdi(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE) IS
        /* Local Declarations */

        LC_vPGMNAME            CONSTANT VARCHAR2(60)                          := 'tar_gbss_prd_file_loading.p_LoadDescToSdi';
        LC_nWRONG_DESC_TYPE    CONSTANT NUMBER(3)                             := 804;
        LC_cRECORD_TYPE        CONSTANT CHAR(1)                               := 'A';

        l_iRecCount                     PLS_INTEGER                           := 0;
        l_nPrdDescId                    prdpdcee.prd_desc_id%TYPE;
        l_vGbssRefNo                    tar_gbss_sty_prd.gbss_ref_no%TYPE;
        l_nColourSequence               tar_gbss_sty_prd.colour_sequence%TYPE;
        l_nErrorCode                    sdicsirej.error_code%TYPE;

        /* Exceptions */

        L_xVALIDATION_ERROR    EXCEPTION;

        /* CURSOR's */
        /* Main Cursor */
        CURSOR l_curGetRefCol IS
            SELECT gbss_ref_no,
                   colour_sequence,
                   product_number
            FROM   tar_gbss_sty_prd
            WHERE  upload_date    IS NULL
            AND    upload_to_base IS NULL
            AND    batch_num = p_nSdiBatchNum;

        /* Cursor to extract thedescription  from Prod XML file */
        CURSOR l_curGetDesc(l_vGbssRefNo      IN VARCHAR2,
                            l_nColourSequence IN NUMBER) IS
            SELECT gbss_ref_no,
                   colour_sequence,
                   description_value,
                   description_type
            FROM   (SELECT xml.gbss_ref_no,
                           xml.colour_sequence,
                           xml.arthur_description,
                           xml.spl1,
                           xml.spl2,
                           xml.pos_desc,
                           xml.feat_tic1,
                           xml.feat_tic2,
                           xml.feat_tic3,
                           xml.feat_tic4,
                           xml.feat_tic5
                    FROM   tar_gbss_prd_file_store xfs,
                           XMLTABLE('for $i in /Brief/Colour
                                     return <row>
                                     {
                                         <colour_sequence>{$i/@seq/string()}</colour_sequence>,
                                         $i/../GBSSRefNo,
                                         $i/Keycode/ArthurDesc,
                                         $i/Keycode/SPLLine1,
                                         $i/Keycode/SPLLine2,
                                         $i/Keycode/POSDesc,
                                         $i/Keycode/FeatureTicketDesc1,
                                         $i/Keycode/FeatureTicketDesc2,
                                         $i/Keycode/FeatureTicketDesc3,
                                         $i/Keycode/FeatureTicketDesc4,
                                         $i/Keycode/FeatureTicketDesc5
                                     }
                                     </row>'
                                     PASSING xfs.filecontent
                                     COLUMNS
                                             gbss_ref_no        PATH 'GBSSRefNo',
                                             colour_sequence    PATH 'colour_sequence',
                                             arthur_description PATH 'ArthurDesc',
                                             spl1               PATH 'SPLLine1',
                                             spl2               PATH 'SPLLine2',
                                             pos_desc           PATH 'POSDesc',
                                             feat_tic1          PATH 'FeatureTicketDesc1',
                                             feat_tic2          PATH 'FeatureTicketDesc2',
                                             feat_tic3          PATH 'FeatureTicketDesc3',
                                             feat_tic4          PATH 'FeatureTicketDesc4',
                                             feat_tic5          PATH 'FeatureTicketDesc5'
                                   ) xml
                    WHERE  xfs.batch_num = p_nSdiBatchNum
                    UNION ALL
                    SELECT '1' AS col1,
                           '2' AS col2,
                           '3' AS col3,
                           '4' AS col4,
                           '5' AS col5,
                           '6' AS col6,
                           '7' AS col7,
                           '8' AS col8,
                           '9' AS col9,
                           '10' AS col10,
                           '11' AS col11
                    FROM   DUAL
                    WHERE  1=2
                   )up_test
                   UNPIVOT(description_value FOR description_type IN
                              (arthur_description AS 'Arthur - 30',
                               spl1               AS 'SPL 1 - 30',
                               spl2               AS 'SPL 2 -30',
                               pos_desc           AS 'POS - 12',
                               feat_tic1          AS 'Feature Ticket 1 - 35',
                               feat_tic2          AS 'Feature Ticket 2 - 35',
                               feat_tic3          AS 'Feature Ticket 3 - 35',
                               feat_tic4          AS 'Feature Ticket 4 - 35',
                               feat_tic5          AS 'Feature Ticket 5 - 35')
                              )
            WHERE  gbss_ref_no       = l_vGbssRefNo
            AND    colour_sequence   = l_nColourSequence;

    BEGIN

        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vstart);

        /* Check if any records to process */
        FOR l_rowRefColCnt IN l_curGetRefCol LOOP
           l_iRecCount := l_iRecCount + 1;
        END LOOP;

        IF l_iRecCount > 0 THEN
           dbms_output.put_line('Style available to process');
        ELSE
            dbms_output.put_line('No styles to process');
            RETURN;
        END IF;
        FOR l_rowRefCol IN l_curGetRefCol LOOP
            BEGIN
                FOR l_rowDesc  IN l_curGetDesc(l_rowRefCol.gbss_ref_no,
                                  l_rowRefCol.colour_sequence) LOOP
                    BEGIN
                        SELECT prd_desc_id
                        INTO   l_nPrdDescId
                        FROM   prdpdcee pde
                        WHERE  pde.prd_desc_name = l_rowDesc.description_type;

                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            NULL;
                            l_nErrorCode := LC_nWRONG_DESC_TYPE;
                            RAISE L_xVALIDATION_ERROR;
                    END;

                    INSERT INTO sdiprddsi(batch_num,
                                          prd_lvl_number,
                                          prd_desc_id,
                                          tran_type,
                                          prd_desc,
                                          prd_desc_name,
                                          prd_desc_length,
                                          desc_create,
                                          date_created,
                                          download_date_1,
                                          download_date_2,
                                          ERROR_CODE
                                         )
                    VALUES(p_nSdiBatchNum,
                           l_rowRefCol.product_number,
                           l_nPrdDescId,
                           LC_cRECORD_TYPE,
                           l_rowDesc.description_value,
                           NULL,
                           NULL,
                           NULL,
                           NULL,
                           NULL,
                           NULL,
                           NULL
                          );
                END LOOP;
            EXCEPTION
                WHEN L_xVALIDATION_ERROR THEN

                    BEGIN
                        INSERT INTO tar_gbss_prd_sdi_upld_rej(script_name ,
                                                              gbss_ref_no,
                                                              product_number,
                                                              colour_sequence,
                                                              reason_code,
                                                              comment1,
                                                              comment2,
                                                              comment3,
                                                              error_date
                                                              )
                        VALUES(LC_vPGMNAME,
                               l_rowRefCol.gbss_ref_no,
                               l_rowRefCol.product_number,
                               l_rowRefCol.colour_sequence,
                               l_nErrorCode,
                               NULL,
                               NULL,
                               NULL,
                               SYSDATE
                              );
                    END;
                WHEN OTHERS THEN
                    ROLLBACK WORK;
                    RAISE;
            END;
        END LOOP;

        COMMIT;

        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vend);
    END p_LoadDescToSdi;

    /************************************************************************
    *
    * NAME:        p_LoadAdditionalToSdi
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This Procedure reads the product registration XML file and and loads the additional fields
    *                       into the sdivalmsi table.
    *
    * USAGE:      p_LoadAdditionalToSdi
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri       17/05/2013  Original Version.
    * Grant Whiteside   06/11/2013  Modify for Standards
    * Brett Rees        20/11/2013  Hardcode basvalee field code instead of using label
    * Brett Rees        11/12/2013  Load VendorItemStyleNo in as RefID/Item No.
    * Brett Rees        02/01/2014  Fixed Style Placeholder being incorrectly mapped to Product Placeholder
    * Ram Kornepati     30/12/2014  SCR13174 - Added call to p_AddOffShowDate
    * Nisa Basheer      19/01/2015  OffShowDate from GBSS
    * Ronald Nava       12/07/2017  Modified XML query construct to improve performance
    * Ronald Nava       24/10/2017  Fixed aliases and cursor names.
    * Ronald Nava       03/06/2019  Added bug fix to address Oracle unpivot bug 14641856
    *************************************************************************/
    PROCEDURE p_LoadAdditionalToSdi (p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE) AS

        /* Local Declarations */
        LC_vPGMNAME                 CONSTANT VARCHAR2(60)                          := 'tar_gbss_prd_file_loading.p_LoadAdditionalToSdi';
        LC_cRECORD_TYPE             CONSTANT CHAR(1)                               := 'A';
        LC_vPRDMSTEE_ENTITY         CONSTANT VARCHAR2(12)                          := 'PRDMSTEE';
        LC_nWRONG_ADD_FIELD_TYPE    CONSTANT NUMBER(3)                             := 805;
        LC_cCODE_ONSHOWDATE         CONSTANT basvalee.field_code%TYPE              := 'OD';
        LC_nMAX_REFID_LENGTH        CONSTANT NUMBER(2)                             := 12;
        /* Off show date from GBSS */
        LC_cCODE_OFFSHOWDATE        CONSTANT basvalee.field_code%TYPE              := 'CD';

        l_iRecCount                          PLS_INTEGER                           := 0;
        l_cFieldCode                         basgenee.field_code%TYPE;
        l_vGbssRefNo                         tar_gbss_sty_prd.gbss_ref_no%TYPE;
        l_nColourSequence                    tar_gbss_sty_prd.colour_sequence%TYPE;
        l_nErrorCode                         sdicsirej.error_code%TYPE;
        l_nAuditNumber                       sdivalmsi.audit_number%TYPE;

        /*off show date */
        l_vOffShowDAte                       sdivalmsi.value%Type;
        l_nCol                               tar_gbss_sty_prd.colour_sequence%TYPE;
        l_vRefNo                             tar_gbss_sty_prd.gbss_ref_no%TYPE;

        /* Exceptions */

        L_xVALIDATION_ERROR EXCEPTION;

        /* CURSOR's */
        /* Main Cursor checks if there is any unprocessed style/Products */
        CURSOR l_curGetRefColour IS
            SELECT gbss_ref_no,
                   colour_sequence,
                   product_number
            FROM   tar_gbss_sty_prd
            WHERE  upload_date    IS NULL
            AND    upload_to_base IS NULL
            AND    batch_num = p_nSdiBatchNum;

         /* Cursor to extract the sell price from Prod XML file for all products from the main cursor above */

         CURSOR l_curGetAddField(l_vGbssRefNo      IN VARCHAR2,
                                 l_nColourSequence IN NUMBER) IS
             SELECT gbss_ref_no,
                    colour_sequence,
                    description_value,
                    field_code
             FROM   (SELECT  xml.gbss_ref_no,
                             xml.colour_sequence,
                             xml.barcode_desc1,
                             xml.barcode_desc2,
                             xml.barcode_col,
                             xml.like_product,
                             xml.min_press_depth,
                             TO_CHAR(TO_DATE(xml.on_show_date,'dd/mm/yyyy'),'DD Mon YYYY') on_show_date,
                             xml.product_type,
                             xml.product_placeholder,
                             xml.gbss_ref_no style_num,
                             xml.model_number,
                             xml.barcode_ticket,
                             SUBSTR(xml.vendor_item_style_no, 0, LC_nMAX_REFID_LENGTH) vendor_item_style_no
                     FROM    tar_gbss_prd_file_store xfs,
                             XMLTABLE('for $i in /Brief/Colour
                                      return <row>
                                      {
                                          <colour_sequence>{$i/@seq/string()}</colour_sequence>,
                                          $i/../GBSSRefNo,
                                          $i/Keycode/BarcodeDesc1,
                                          $i/Keycode/BarcodeDesc2,
                                          $i/Keycode/BarcodeColour,
                                          $i/Keycode/LikeProduct,
                                          $i/Keycode/MinPresDepth,
                                          $i/Keycode/OnShowDate,
                                          $i/Keycode/ProductType,
                                          $i/OptionPlaceholderNo,
                                          $i/../StylePlaceholderNo,
                                          $i/Keycode/ModelNumber,
                                          $i/Keycode/BarcodeTicket,
                                          $i/../VendorItemStyleNo
                                      }
                                      </row>'              PASSING xfs.filecontent COLUMNS
                                      gbss_ref_no          PATH 'GBSSRefNo',
                                      colour_sequence      PATH 'colour_sequence',
                                      barcode_desc1        PATH 'BarcodeDesc1',
                                      barcode_desc2        PATH 'BarcodeDesc2',
                                      barcode_col          PATH 'BarcodeColour',
                                      like_product         PATH 'LikeProduct',
                                      min_press_depth      PATH 'MinPresDepth',
                                      on_show_date         PATH 'OnShowDate',
                                      product_type         PATH 'ProductType',
                                      product_placeholder  PATH 'OptionPlaceholderNo',
                                      ap_prdplace_no       PATH 'StylePlaceholderNo',
                                      model_number         PATH 'ModelNumber',
                                      barcode_ticket       PATH 'BarcodeTicket',
                                      vendor_item_style_no PATH 'VendorItemStyleNo'
                                      ) xml
                     WHERE   xfs.batch_num = p_nSdiBatchNum
                     UNION ALL
                     SELECT '1' AS col1,
                            '2' AS col2,
                            '3' AS col3,
                            '4' AS col4,
                            '5' AS col5,
                            '6' AS col6,
                            '7' AS col7,
                            '8' AS col8,
                            '9' AS col9,
                            '10' AS col10,
                            '11' AS col11,
                            '12' AS col12,
                            '13' AS col13,
                            '14' AS col14
                     FROM   DUAL
                     WHERE  1=2
                    ) up_test
             UNPIVOT(description_value FOR field_code IN
                        (barcode_desc1        AS 'B1',
                         barcode_desc2        AS 'B2',
                         barcode_col          AS 'BC',
                         like_product         AS 'LP',
                         min_press_depth      AS 'MP',
                         on_show_date         AS 'OD',
                         product_type         AS 'PT',
                         product_placeholder  AS 'PP',
                         style_num            AS 'SN',
                         model_number         AS 'MN',
                         barcode_ticket       AS 'BT',
                         vendor_item_style_no AS 'VC'
                        )
                    )
             WHERE  colour_sequence = l_nColourSequence
             AND    gbss_ref_no     = l_vGbssRefNo
             AND    description_value IS NOT NULL;

    BEGIN

        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vstart);

        FOR l_rowRefColCnt IN l_curGetRefColour LOOP
           l_iRecCount := l_iRecCount + 1;
        END LOOP;

        IF l_iRecCount > 0 THEN
           dbms_output.put_line('Style available to process');
        ELSE
           dbms_output.put_line('No styles to process');
           RETURN;
        END IF;
        FOR l_rowRefCol IN l_curGetRefColour LOOP
            BEGIN
                FOR l_rowAddField IN l_curGetAddField(l_rowRefCol.gbss_ref_no,
                                                      l_rowRefCol.colour_sequence) LOOP

                    SELECT audit_number.NEXTVAL
                    INTO   l_nAuditNumber
                    FROM   dual;

                    INSERT INTO sdivalmsi(audit_number,
                                          tran_type,
                                          org_lvl_number,
                                          prd_lvl_number,
                                          pmg_po_number,
                                          pmg_line_number,
                                          pmg_dtl_tech_key,
                                          field_code,
                                          entity_name,
                                          VALUE,
                                          val_err_code,
                                          date_created,
                                          download_date_1,
                                          download_date_2)
                    VALUES(l_nAuditNumber,
                           LC_cRECORD_TYPE,
                           NULL,
                           l_rowRefCol.product_number,
                           NULL,
                           NULL,
                           NULL,
                           l_rowAddField.field_code,
                           LC_vPRDMSTEE_ENTITY,
                           l_rowAddField.description_value,
                           NULL,
                           NULL,
                           NULL,
                           NULL
                           );


                  -- If inserting 'On Show Date', also calculate and insert 'Off Show Date'
                  IF l_rowAddField.field_code = LC_cCODE_ONSHOWDATE THEN

                  --get offshowdate from xml
                        BEGIN
                         SELECT description_value ,
                                gbss_ref_no,
                                colour_sequence
                         INTO l_vOffShowDAte,
                              l_vRefNo,
                              l_nCol
                         FROM (SELECT TO_CHAR(TO_DATE(col.off_show_date,'dd/mm/yyyy'),'dd Mon YYYY') description_value,
                                      col.gbss_ref_no,
                                      col.colour_sequence
                               FROM   tar_gbss_prd_file_store xfs,
                                      XMLTABLE ('for $i in /Brief/Colour
                                                 return <row>
                                                 {
                                                      <colour_sequence>{$i/@seq/string()}</colour_sequence>,
                                                      $i/../GBSSRefNo,
                                                      $i/Keycode/OffShowDate
                                                 }
                                                 </row>'
                                                 PASSING xfs.filecontent
                                                 COLUMNS gbss_ref_no     PATH 'GBSSRefNo',
                                                         colour_sequence PATH 'colour_sequence',
                                                         off_show_date   PATH 'OffShowDate'
                                               ) col
                               WHERE   xfs.batch_num = p_nSdiBatchNum
                              )
                         WHERE  gbss_ref_no        = l_rowRefCol.gbss_ref_no
                         AND    colour_sequence    = l_rowRefCol.colour_sequence
                         AND    description_value IS NOT NULL;

                          INSERT INTO sdivalmsi(audit_number,
                                              tran_type,
                                              org_lvl_number,
                                              prd_lvl_number,
                                              pmg_po_number,
                                              pmg_line_number,
                                              pmg_dtl_tech_key,
                                              field_code,
                                              entity_name,
                                              VALUE,
                                              val_err_code,
                                              date_created,
                                              download_date_1,
                                              download_date_2)
                            SELECT audit_number.NEXTVAL,
                                   LC_cRECORD_TYPE,
                                   NULL,
                                   l_rowRefCol.product_number,
                                   NULL,
                                   NULL,
                                   NULL,
                                   LC_cCODE_OFFSHOWDATE,
                                   LC_vPRDMSTEE_ENTITY,
                                   l_vOffShowDAte,
                                   NULL,
                                   NULL,
                                   NULL,
                                   NULL
                            FROM   DUAL;



                        EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                             p_AddOffShowDate(l_rowRefCol.product_number);
                        END;

                    END IF;

                END LOOP;
            EXCEPTION
                WHEN L_xVALIDATION_ERROR THEN
                    BEGIN
                        INSERT INTO tar_gbss_prd_sdi_upld_rej(script_name ,
                                                              gbss_ref_no,
                                                              product_number,
                                                              colour_sequence,
                                                              reason_code,
                                                              comment1,
                                                              comment2,
                                                              comment3,
                                                              error_date
                                                              )
                        VALUES(LC_vPGMNAME,
                               l_rowRefCol.gbss_ref_no,
                               l_rowRefCol.product_number,
                               l_rowRefCol.colour_sequence,
                               l_nErrorCode,
                               'Additional Field not correct',
                               NULL,
                               NULL,
                               SYSDATE
                              );
                    END;
                WHEN OTHERS THEN
                    ROLLBACK WORK;
                    RAISE;
            END;
        END LOOP;

        COMMIT;

    END p_LoadAdditionalToSdi;

    /************************************************************************
    *
    * NAME:        p_LoadHdrToSdi
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This Procedure will associate every style/colour to a system generated
    *                       product for the product registration files received from GBSS system.
    *
    * USAGE:      p_LoadHdrToSdi
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri       17/05/2013  Original Version.
    * Grant Whiteside   06/11/2013  Modify for Standards
    * Nisa Basheer      16/06/2014  Added validation to encoporate dummy dimension.
    * Ronald Nava       05/07/2017  Modified XML query construct to improve performance
    * Ronald Nava       24/10/2017  Fixed aliases and cursor names.
    * Cursor Agent      24/09/2026  Scope sty_prd to current batch/unprocessed rows; clear
    *                               SDIPRDMSI for batch before insert (SDIPRDMSIP1).
    *************************************************************************/

    PROCEDURE p_LoadHdrToSdi(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE) IS

        /* Local Declarations */
        LC_vPGMNAME          CONSTANT VARCHAR2(60)                          := 'tar_gbss_prd_file_loading.p_LoadHdrToSdi';
        LC_cRECORD_TYPE      CONSTANT CHAR(1)                               := 'A';

        l_iRecCount                   PLS_INTEGER                           := 0;
        l_nPrdLvlId                   sdiprdmsi.prd_lvl_id%TYPE             := 1;
        l_nPrdStatus                  prdmstee.prd_status%TYPE;
        l_vGbssRefNo                  tar_gbss_sty_prd.gbss_ref_no%TYPE;
        l_nColourSequence             tar_gbss_sty_prd.colour_sequence%TYPE;
        l_cStyleFlag                  prdmstee.prd_style_ind%TYPE;


        /* CURSOR's */
        /* Main Cursor */
        CURSOR l_curGetRefCol IS
            SELECT DISTINCT gbss_ref_no
            FROM   tar_gbss_sty_prd
            WHERE  upload_date    IS NULL
            AND    upload_to_base IS NULL
            AND    batch_num = p_nSdiBatchNum;

        /* Cursor to extract the Hdr information from XML */

        CURSOR l_curPrdHdrInfo(l_vGbssRefNo      IN VARCHAR2) IS
            SELECT DISTINCT xml.gbss_ref_no,
                   xml.colour_sequence,
                   xml.range,
                   xml.product_name,
                   xml.dimension_name,
                   sty.product_number
            FROM   tar_gbss_prd_file_store xfs,
                   tar_gbss_sty_prd sty,
                   XMLTABLE('for $i in /Brief/Colour
                             return <row>
                             {
                                  <colour_sequence>{$i/@seq/string()}</colour_sequence>,
                                  $i/../GBSSRefNo,
                                  $i/../Range,
                                  $i/Keycode/ProductName,
                                  $i/../SizeTemplateName
                             }
                             </row>'
                             PASSING xfs.filecontent
                             COLUMNS gbss_ref_no     PATH 'GBSSRefNo',
                                     colour_sequence PATH 'colour_sequence',
                                     RANGE           PATH 'Range',
                                     product_name    PATH 'ProductName',
                                     dimension_name  PATH 'SizeTemplateName'
                           ) xml
            WHERE  xml.gbss_ref_no     = l_vGbssRefNo
            AND    xfs.batch_num       = p_nSdiBatchNum
            AND    sty.batch_num       = p_nSdiBatchNum
            AND    sty.upload_date     IS NULL
            AND    sty.upload_to_base  IS NULL
            AND    sty.product_number  IS NOT NULL
            AND    xml.gbss_ref_no     = sty.gbss_ref_no
            AND    xml.colour_sequence = sty.colour_sequence
            AND    sty.ROWID = (SELECT MIN(sty2.ROWID)
                                FROM   tar_gbss_sty_prd sty2
                                WHERE  sty2.batch_num       = p_nSdiBatchNum
                                AND    sty2.gbss_ref_no     = sty.gbss_ref_no
                                AND    sty2.colour_sequence = sty.colour_sequence
                                AND    sty2.upload_date     IS NULL
                                AND    sty2.upload_to_base  IS NULL
                                AND    sty2.product_number  IS NOT NULL);

    BEGIN

        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vstart);

        FOR l_rowRefColCnt IN l_curGetRefCol LOOP
            l_iRecCount := l_iRecCount + 1;
        END LOOP;

        IF l_iRecCount > 0 THEN
            dbms_output.put_line('Style available to process');
        ELSE
            dbms_output.put_line('No styles to process');
            RETURN;
        END IF;

        /* Make header load idempotent for job reruns (SDIPRDMSIP1). */
        DELETE FROM sdiprdmsi
        WHERE  batch_num = p_nSdiBatchNum;

        FOR l_rowRefCol IN l_curGetRefCol LOOP
            BEGIN
                FOR l_rowPrdHdr IN l_curPrdHdrInfo(l_rowRefCol.gbss_ref_no) LOOP
                    IF l_rowPrdHdr.dimension_name IS NULL OR l_rowPrdHdr.dimension_name = GC_cDUMMY_DIMENSION THEN
                        l_cStyleFlag := GC_cFALSE;
                    ELSE
                        l_cStyleFlag := GC_cTRUE;
                    END IF;

                    INSERT INTO sdiprdmsi (batch_num,
                                           prd_lvl_number,
                                           prd_lvl_id,
                                           tran_type,
                                           prd_lvl_parent,
                                           prd_name_full,
                                           prd_targetgm,
                                           prd_style_ind,
                                           prd_status,
                                           prd_inh_val,
                                           prd_pdh_name_1
                                          )
                    VALUES(p_nSdiBatchNum,
                           l_rowPrdHdr.product_number,
                           l_nPrdLvlId,
                           LC_cRECORD_TYPE,
                           l_rowPrdHdr.range,
                           UPPER(l_rowPrdHdr.product_name),
                           NULL,
                           l_cStyleFlag,
                           l_nPrdStatus,
                           GC_nZERO,
                           DECODE(l_rowPrdHdr.dimension_name, GC_cDUMMY_DIMENSION, NULL, l_rowPrdHdr.dimension_name)
                           );
                END LOOP;
            EXCEPTION
                WHEN OTHERS THEN
                    ROLLBACK;
                    RAISE;
            END;
        END LOOP;
        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vend);
        COMMIT;

   END p_LoadHdrToSdi;

    /************************************************************************
    *
    * NAME:        p_ReportSdiLoadErrors
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This Procedure Will Identify the errored product records
    *              while loading to SDI and delete the staging layer
    *              data so that it is not processed by Base procedures
    *              and create partial products.
    * USAGE:      p_ReportSdiLoadErrors
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri       17/05/2013  Original Version.
    * Grant Whiteside   06/11/2013  Modify for Standards
    *
    *************************************************************************/

    PROCEDURE p_ReportSdiLoadErrors(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE) IS

        /* Local Declarations */
        LC_vPGMNAME CONSTANT VARCHAR2(30) := 'p_ReportSdiLoadErrors';
        l_iErrCnt            PLS_INTEGER;

        /* Cursor definitions */
        CURSOR l_curStyPrd IS
            SELECT sty_prd.product_number
            FROM   tar_gbss_sty_prd sty_prd
            WHERE  sty_prd.upload_date      IS NULL
            AND    sty_prd.load_to_sdi_flag IS NULL
            AND    batch_num = p_nSdiBatchNum;

    BEGIN
        FOR l_rowStyPrd IN l_curStyPrd LOOP
            BEGIN
                SELECT COUNT(*)
                INTO   l_iErrCnt
                FROM   tar_gbss_prd_sdi_upld_rej rej
                WHERE  rej.product_number = l_rowStyPrd.product_number;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    l_iErrCnt := 0;
            END;
            IF l_iErrCnt = 0 THEN
                UPDATE tar_gbss_sty_prd sty_prd
                SET    sty_prd.load_to_sdi_flag = GC_cTRUE
                WHERE  sty_prd.product_number   = l_rowStyPrd.product_number
                AND    sty_prd.batch_num = p_nSdiBatchNum;
            ELSE
                UPDATE tar_gbss_sty_prd sty_prd
                SET    sty_prd.load_to_sdi_flag = GC_cFALSE,
                       sty_prd.sdi_reg_status   = GC_cFALSE
                WHERE  sty_prd.product_number   = l_rowStyPrd.product_number
                AND    sty_prd.batch_num = p_nSdiBatchNum;

                DELETE sdiprdmsi hdr
                WHERE  hdr.prd_lvl_number   = l_rowStyPrd.product_number
                AND    batch_num            = p_nSdiBatchNum;

                DELETE sdiprdati att
                WHERE  att.prd_lvl_number   = l_rowStyPrd.product_number
                AND    batch_num            = p_nSdiBatchNum;

                DELETE sdivalmsi add_f
                WHERE  add_f.prd_lvl_number = l_rowStyPrd.product_number;

                DELETE prdprcee prc
                WHERE  prc.prd_lvl_number   = l_rowStyPrd.product_number
                AND    batch_num            = p_nSdiBatchNum;

                DELETE sdivpccsi cpk
                WHERE  cpk.prd_lvl_number   = l_rowStyPrd.product_number
                AND    batch_num            = p_nSdiBatchNum;

                DELETE sdiprddsi de
                WHERE  de.prd_lvl_number    = l_rowStyPrd.product_number
                AND    batch_num            = p_nSdiBatchNum;
            END IF;
        END LOOP;

        COMMIT;

        EXCEPTION
            WHEN OTHERS THEN
                ROLLBACK;
                dbms_output.put_line('Error in '|| LC_vPGMNAME ||': '||SQLCODE ||' - '|| SQLERRM);
                RAISE;

   END p_ReportSdiLoadErrors;

    /************************************************************************
    *
    * NAME:        p_SdiProcessErrors
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This Procedure Will Identify the errored product records while loading to SDI
    *              and delete the staging layer data so that it is not processed by Base procedures
    *              and create partial products.
    *
    * USAGE:      p_SdiProcessErrors
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri       17/05/2013  Original Version.
    * Grant Whiteside   06/11/2013  Modify for Standards
    * Brett Rees        14/11/2013  Added an update to set the prd_lvl_child in tar_gbss_sty_prd
    * Brett Rees        04/12/2013  Add additional detailed error messages for missing mandatory attributes / non-existant attributes.
    *
    *************************************************************************/

    PROCEDURE p_SdiProcessErrors(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE) IS

         /* Local Declarations */
        LC_vPGMNAME                 CONSTANT VARCHAR2(30)                := 'p_SdiProcessErrors';
        LC_vAPP_FUNC_PRD            CONSTANT basatyee.app_func%TYPE      := 'PRD';
        LC_nSOLID_CASE_ERROR_CODE   CONSTANT NUMBER(3)                   := 786;
        LC_nMISSING_MAN_ATT         CONSTANT sdiprdati.error_code%TYPE   := 422;

        l_iHdrError                          PLS_INTEGER  := NULL;
        l_iAddError                          PLS_INTEGER  := NULL;
        l_iCasePackError                     PLS_INTEGER  := NULL;
        l_iDescError                         PLS_INTEGER  := NULL;
        l_iPrcError                          PLS_INTEGER  := NULL;
        l_iCostError                         PLS_INTEGER  := NULL;
        l_iSolidCaseError                    PLS_INTEGER  := NULL;
        l_cExistingStatus                    tar_gbss_sty_prd.casepack_status%TYPE;

        CURSOR l_curStyPrd IS
            SELECT sty_prd.product_number,
                   sty_prd.gbss_ref_no,
                   sty_prd.colour_sequence
            FROM   tar_gbss_sty_prd sty_prd
            WHERE  sty_prd.upload_date      IS NULL
            AND    sty_prd.upload_to_base   IS NULL
            AND    sty_prd.load_to_sdi_flag <> GC_cFALSE
            AND    sty_prd.batch_num = p_nSdiBatchNum;

        CURSOR l_curPrdMissManAtt IS
            SELECT sdi.prd_lvl_number
            FROM   sdiprdmsi sdi
            WHERE  sdi.error_code = LC_nMISSING_MAN_ATT
            AND    sdi.batch_num  = p_nSdiBatchNum;

        CURSOR l_curMissManAttDtl(p_cPrdLvlNumber IN sdiprdati.prd_lvl_number%TYPE) IS
            SELECT typ.atr_type_desc,
                   hdr.atr_header_desc
            FROM   basahree hdr,
                   basatyee typ
            WHERE  typ.app_func         = LC_vAPP_FUNC_PRD
            AND    hdr.att_mandatory    = GC_cTRUE
            AND    hdr.atr_typ_tech_key = typ.atr_typ_tech_key
            AND    NOT EXISTS (SELECT 1
                               FROM   sdiprdati sdi
                               WHERE  hdr.atr_hdr_tech_key = sdi.atr_hdr_tech_key
                               AND    typ.atr_typ_tech_key = sdi.atr_typ_tech_key
                               AND    sdi.prd_lvl_number   = p_cPrdLvlNumber);

    BEGIN

        FOR l_rowStyPrd IN l_curStyPrd LOOP
            l_iHdrError      := NULL;
            l_iAddError      := NULL;
            l_iCasePackError := NULL;
            l_iDescError     := NULL;
            l_iPrcError      := NULL;
            l_iCostError     := NULL;

            BEGIN
                /* header or attribute error */
                SELECT 1
                INTO   l_iHdrError
                FROM   sdiprdmsi hdr
                WHERE  hdr.prd_lvl_number = l_rowStyPrd.product_number
                AND    hdr.error_code     IS NOT NULL
                AND    hdr.batch_num      = p_nSdiBatchNum
                GROUP  BY hdr.prd_lvl_number;

                UPDATE tar_gbss_sty_prd sty_prd
                SET    sty_prd.header_status    = GC_cFALSE,
                       sty_prd.attribute_status = GC_cFALSE,
                       sty_prd.sdi_reg_status   = GC_cFALSE
                WHERE  sty_prd.product_number   = l_rowStyPrd.product_number
                AND    sty_prd.batch_num = p_nSdiBatchNum;

            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    UPDATE tar_gbss_sty_prd sty_prd
                    SET    sty_prd.header_status    = GC_cTRUE,
                           sty_prd.attribute_status = GC_cTRUE
                    WHERE  sty_prd.product_number   = l_rowStyPrd.product_number
                    AND    sty_prd.batch_num = p_nSdiBatchNum;
            END;
            /* Add Detailed Missing Mandatory Attribute errors*/
            BEGIN

                FOR l_rowMissManAttDtl IN l_curMissManAttDtl(l_rowStyPrd.product_number) LOOP

                    INSERT INTO tar_gbss_prd_sdi_upld_rej(script_name,
                                                          gbss_ref_no,
                                                          product_number,
                                                          colour_sequence,
                                                          reason_code,
                                                          comment1,
                                                          error_date)
                    VALUES(LC_vPGMNAME,
                           l_rowStyPrd.gbss_ref_no,
                           l_rowStyPrd.product_number,
                           l_rowStyPrd.colour_sequence,
                           LC_nMISSING_MAN_ATT,
                           'Missing mandatory attribute. ' || l_rowMissManAttDtl.atr_type_desc || ' | ' || l_rowMissManAttDtl.atr_header_desc,
                           SYSDATE);

                END LOOP;

            END;

             /* Additional Field Errors */
            BEGIN
                SELECT 1
                INTO   l_iAddError
                FROM   sdivalmsi ad
                WHERE  ad.prd_lvl_number = l_rowStyPrd.product_number
                AND    ad.val_err_code   IS NOT NULL
                GROUP  BY ad.prd_lvl_number;

                UPDATE tar_gbss_sty_prd sty_prd
                SET    sty_prd.additional_field_status = GC_cFALSE,
                       sty_prd.sdi_reg_status          = GC_cFALSE
                WHERE  sty_prd.product_number          = l_rowStyPrd.product_number
                AND    sty_prd.batch_num = p_nSdiBatchNum;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    UPDATE tar_gbss_sty_prd sty_prd
                    SET    sty_prd.additional_field_status = GC_cTRUE
                    WHERE  sty_prd.product_number          = l_rowStyPrd.product_number
                    AND    sty_prd.batch_num = p_nSdiBatchNum;
            END;
            /* Casepack Errors */
            BEGIN
                SELECT 1
                INTO   l_iCasePackError
                FROM   sdivpcrej crej
                WHERE  crej.prd_lvl_number = l_rowStyPrd.product_number
                AND    crej.error_code     IS NOT NULL
                AND    crej.batch_num      = p_nSdiBatchNum
                GROUP  BY crej.prd_lvl_number;

                UPDATE tar_gbss_sty_prd sty_prd
                SET    sty_prd.casepack_status = GC_cFALSE,
                       sty_prd.sdi_reg_status  = GC_cFALSE
                WHERE  sty_prd.product_number  = l_rowStyPrd.product_number
                AND    sty_prd.batch_num = p_nSdiBatchNum;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    UPDATE tar_gbss_sty_prd sty_prd
                    SET    sty_prd.casepack_status = GC_cTRUE
                    WHERE  sty_prd.product_number  = l_rowStyPrd.product_number
                    AND    sty_prd.batch_num = p_nSdiBatchNum;
            END;

            /* solidcase pack issues */

            BEGIN

                /* this is for the solidcase packs some error is detected for the solidcase packs */
                SELECT 1
                INTO   l_iSolidCaseError
                FROM   tar_gbss_prd_sdi_upld_rej mr
                WHERE  mr.product_number = l_rowStyPrd.product_number
                AND    mr.reason_code    = LC_nSOLID_CASE_ERROR_CODE
                GROUP  BY mr.product_number;

                UPDATE tar_gbss_sty_prd sty_prd
                SET    sty_prd.casepack_status = GC_cFALSE,
                       sty_prd.sdi_reg_status  = GC_cFALSE
                WHERE  sty_prd.product_number  = l_rowStyPrd.product_number
                AND    sty_prd.batch_num = p_nSdiBatchNum;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    SELECT casepack_status
                    INTO   l_cExistingStatus
                    FROM   tar_gbss_sty_prd sty_prd
                    WHERE  sty_prd.product_number = l_rowStyPrd.product_number
                    AND    sty_prd.batch_num = p_nSdiBatchNum;

                    IF l_cExistingStatus = GC_cTRUE THEN

                        UPDATE tar_gbss_sty_prd sty_prd
                        SET    sty_prd.casepack_status = GC_cTRUE
                        WHERE  sty_prd.product_number  = l_rowStyPrd.product_number
                        AND    sty_prd.batch_num = p_nSdiBatchNum;

                    END IF;
            END;

             /* Costing Errors */

            BEGIN
                SELECT 1
                INTO   l_iCostError
                FROM   prdcstrej cst
                WHERE  cst.prd_lvl_number = l_rowStyPrd.product_number
                AND    cst.error_code     IS NOT NULL
                AND    cst.batch_num      = p_nSdiBatchNum
                GROUP  BY cst.prd_lvl_number;

                UPDATE tar_gbss_sty_prd sty_prd
                SET    sty_prd.costing_status = GC_cFALSE,
                       sty_prd.sdi_reg_status = GC_cFALSE
                WHERE  sty_prd.product_number = l_rowStyPrd.product_number
                AND    sty_prd.batch_num = p_nSdiBatchNum;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    UPDATE tar_gbss_sty_prd sty_prd
                    SET    sty_prd.costing_status = GC_cTRUE
                    WHERE  sty_prd.product_number = l_rowStyPrd.product_number
                    AND    sty_prd.batch_num = p_nSdiBatchNum;
            END;
            /* Description Errors */
            BEGIN
                SELECT 1
                INTO   l_iDescError
                FROM   sdiprddsi drej
                WHERE  drej.prd_lvl_number = l_rowStyPrd.product_number
                AND    drej.error_code     IS NOT NULL
                AND    drej.batch_num      = p_nSdiBatchNum
                GROUP  BY drej.prd_lvl_number;

                UPDATE tar_gbss_sty_prd sty_prd
                SET    sty_prd.description_status = GC_cFALSE,
                       sty_prd.sdi_reg_status     = GC_cFALSE
                WHERE  sty_prd.product_number     = l_rowStyPrd.product_number
                AND    sty_prd.batch_num = p_nSdiBatchNum;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    UPDATE tar_gbss_sty_prd sty_prd
                    SET    sty_prd.description_status = GC_cTRUE
                    WHERE  sty_prd.product_number     = l_rowStyPrd.product_number
                    AND    sty_prd.batch_num = p_nSdiBatchNum;
            END;

            /* Price Errors */
            BEGIN
                SELECT 1
                INTO   l_iPrcError
                FROM   prdprcrej prej
                WHERE  prej.prd_lvl_number = l_rowStyPrd.product_number
                AND    prej.error_code     IS NOT NULL
                AND    prej.batch_num      = p_nSdiBatchNum
                GROUP  BY prej.prd_lvl_number;

                UPDATE tar_gbss_sty_prd sty_prd
                SET    sty_prd.price_status   = GC_cFALSE,
                       sty_prd.sdi_reg_status = GC_cFALSE
                WHERE  sty_prd.product_number = l_rowStyPrd.product_number
                AND    sty_prd.batch_num = p_nSdiBatchNum;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    UPDATE tar_gbss_sty_prd sty_prd
                    SET    sty_prd.price_status   = GC_cTRUE
                    WHERE  sty_prd.product_number = l_rowStyPrd.product_number
                    AND    sty_prd.batch_num = p_nSdiBatchNum;
            END;
            BEGIN
                IF (l_iHdrError        = 1 OR
                    l_iAddError        = 1 OR
                    l_iCasePackError   = 1 OR
                    l_iDescError       = 1 OR
                    l_iPrcError        = 1) THEN
                    UPDATE tar_gbss_sty_prd sty_prd
                    SET    sty_prd.sdi_reg_status         = GC_cFALSE,
                           sty_prd.overall_prd_reg_status = GC_cFALSE
                    WHERE  sty_prd.product_number         = l_rowStyPrd.product_number
                    AND    sty_prd.batch_num = p_nSdiBatchNum;
                ELSE
                    UPDATE tar_gbss_sty_prd sty_prd
                    SET    sty_prd.sdi_reg_status = GC_cTRUE
                    WHERE  sty_prd.product_number = l_rowStyPrd.product_number
                    AND    sty_prd.batch_num = p_nSdiBatchNum;
                END IF;
            END;
            /* mark record in control to show that SDI processing is done */
            UPDATE tar_gbss_sty_prd sty
            SET    sty.upload_to_base = SYSDATE,
                   prd_lvl_child      = (SELECT prd.prd_lvl_child
                                         FROM   prdmstee prd
                                         WHERE  prd.prd_lvl_number = sty.product_number)
            WHERE  sty.upload_to_base IS NULL
            AND    sty.product_number = l_rowStyPrd.product_number
            AND    sty.batch_num = p_nSdiBatchNum;



        END LOOP;

        COMMIT;

    END p_SdiProcessErrors;

    /************************************************************************
    *
    * NAME:        p_LoadPrdWmsAtt
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This Procedure loads the WMS specific attributes into a table
    *                       to be used in future
    *
    * USAGE:      p_LoadPrdWmsAtt
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri        17/05/2013   Original Version.
    * Brett Rees         19/11/2013   Continue processing when product number not found
    * Brett Rees         27/05/2014   Limit Customs Item Description to 150 chars
    * Ronald Nava        05/07/2017   Modified XML query construct to improve performance
    * Ronald Nava        24/10/2017   Fixed aliases and cursor names.
    *************************************************************************/

    PROCEDURE p_LoadPrdWmsAtt(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE) AS

        /* Local Declarations */
        LC_vPGMNAME      CONSTANT VARCHAR2(30) := 'p_LoadPrdWmsAtt';
        l_nPrdLvlChild            prdmstee.prd_lvl_child%TYPE;

        /* Main Cursor */

        CURSOR l_curRefColour IS
            SELECT gbss_ref_no,
                   colour_sequence,
                   product_number
            FROM   tar_gbss_sty_prd
            WHERE  upload_date IS NULL
            AND    upload_to_base IS NULL
            AND    batch_num = p_nSdiBatchNum;
        /* WMS related attributes */
        CURSOR l_curWmsAttDtl(l_vGbssRefNo      IN VARCHAR2,
                              l_nColourSequence IN NUMBER) IS
            SELECT *
            FROM   (SELECT DISTINCT xml.gbss_ref_no,
                           xml.colour_sequence,
                           xml.unitsperinner,
                           xml.innersperouter,
                           xml.unitsperouter,
                           xml.unitspercbm,
                           xml.outercartonheight,
                           xml.outercartonwidth,
                           xml.outercartonlength,
                           xml.outercartoncbm,
                           xml.outercartongrossweight,
                           xml.innercartonheight,
                           xml.innercartonwidth,
                           xml.innercartonlength,
                           xml.innercartoncbm,
                           xml.innercartonweight,
                           xml.deliveryunitdimensionsheight,
                           xml.deliveryunitdimensionswidth,
                           xml.deliveryunitdimensionslength,
                           xml.deliveryunitdimprdtweight,
                           xml.fragile,
                           xml.temperaturecontrolled,
                           xml.dangerousgoods,
                           xml.dgclass,
                           xml.hazmatnumber,
                           xml.unnumber,
                           xml.packaginggroup,
                           SUBSTR(xml.custom_desc, 0, 150) custom_desc
                    FROM   tar_gbss_prd_file_store xfs,
                           XMLTABLE('for $i in /Brief/Colour
                                     return <row>
                                     {
                                          <colour_sequence>{$i/@seq/string()}</colour_sequence>,
                                          $i/../GBSSRefNo,
                                          $i/../SizeTemplateName,
                                          $i/../UnitsPerInner,
                                          $i/../InnersPerOuter,
                                          $i/../UnitsPerOuter,
                                          $i/../UnitsPerCBM,
                                          $i/../OuterCartonHeight,
                                          $i/../OuterCartonWidth,
                                          $i/../OuterCartonLength,
                                          $i/../OuterCartonCBM,
                                          $i/../OuterCartonGrossWeight,
                                          $i/../InnerCartonHeight,
                                          $i/../InnerCartonWidth,
                                          $i/../InnerCartonLength,
                                          $i/../InnerCartonCBM,
                                          $i/../InnerCartonWeight,
                                          $i/../DeliveryUnitDimensionsHeight,
                                          $i/../DeliveryUnitDimensionsWidth,
                                          $i/../DeliveryUnitDimensionsLength,
                                          $i/../DeliveryUnitDimensionsProductWeight,
                                          $i/../Fragile,
                                          $i/../TemperatureControlled,
                                          $i/../DangerousGoods,
                                          $i/../DGClass,
                                          $i/../HAZMATNumber,
                                          $i/../UNNumber,
                                          $i/../PackagingGroup,
                                          $i/../CustomsItemDesc
                                     }
                                     </row>'
                                     PASSING xfs.filecontent
                                     COLUMNS gbss_ref_no                  PATH 'GBSSRefNo',
                                             colour_sequence              PATH 'colour_sequence',
                                             dimension_name               PATH 'SizeTemplateName',
                                             unitsperinner                PATH 'UnitsPerInner',
                                             innersperouter               PATH 'InnersPerOuter',
                                             unitsperouter                PATH 'UnitsPerOuter',
                                             unitspercbm                  PATH 'UnitsPerCBM',
                                             outercartonheight            PATH 'OuterCartonHeight',
                                             outercartonwidth             PATH 'OuterCartonWidth',
                                             outercartonlength            PATH 'OuterCartonLength',
                                             outercartoncbm               PATH 'OuterCartonCBM',
                                             outercartongrossweight       PATH 'OuterCartonGrossWeight',
                                             innercartonheight            PATH 'InnerCartonHeight',
                                             innercartonwidth             PATH 'InnerCartonWidth',
                                             innercartonlength            PATH 'InnerCartonLength',
                                             innercartoncbm               PATH 'InnerCartonCBM',
                                             innercartonweight            PATH 'InnerCartonWeight',
                                             deliveryunitdimensionsheight PATH 'DeliveryUnitDimensionsHeight',
                                             deliveryunitdimensionswidth  PATH 'DeliveryUnitDimensionsWidth',
                                             deliveryunitdimensionslength PATH 'DeliveryUnitDimensionsLength',
                                             deliveryunitdimprdtweight    PATH 'DeliveryUnitDimensionsProductWeight',
                                             fragile                      PATH 'Fragile',
                                             temperaturecontrolled        PATH 'TemperatureControlled',
                                             dangerousgoods               PATH 'DangerousGoods',
                                             dgclass                      PATH 'DGClass',
                                             hazmatnumber                 PATH 'HAZMATNumber',
                                             unnumber                     PATH 'UNNumber',
                                             packaginggroup               PATH 'PackagingGroup',
                                             custom_desc                  PATH 'CustomsItemDesc'
                                   ) xml
                    WHERE xfs.batch_num = p_nSdiBatchNum
                   ) xmltab
            WHERE  xmltab.gbss_ref_no     = l_vGbssRefNo
            AND    xmltab.colour_sequence = l_nColourSequence;

    BEGIN
        FOR l_rowRefColour IN l_curRefColour LOOP
            BEGIN
                FOR l_rowWmsAttDtl IN l_curWmsAttDtl(l_rowRefColour.gbss_ref_no,
                                                     l_rowRefColour.colour_sequence) LOOP

                    BEGIN
                        SELECT prd.prd_lvl_child
                        INTO   l_nPrdLvlChild
                        FROM   prdmstee prd
                        WHERE  prd.prd_lvl_number = l_rowRefColour.product_number;

                        BEGIN
                            INSERT INTO tar_gbss_prd_wms_att(gbss_ref_no,
                                                             product_number,
                                                             units_per_inner,
                                                             inners_per_outer,
                                                             units_per_outer,
                                                             units_per_cbm,
                                                             o_carton_height,
                                                             o_carton_width,
                                                             o_carton_length,
                                                             o_carton_cbm,
                                                             o_carton_gross_weight,
                                                             i_carton_height,
                                                             i_carton_width,
                                                             i_carton_length,
                                                             i_carton_cbm,
                                                             i_carton_weight,
                                                             deli_unit_dim_height,
                                                             deli_unit_dim_width,
                                                             deli_unit_dim_length,
                                                             deli_unit_dim_product_weight,
                                                             fragile,
                                                             temp_controlled,
                                                             dangerous_goods,
                                                             dg_class,
                                                             hazmat_number,
                                                             un_number,
                                                             packaging_group)
                            VALUES(l_rowWmsAttDtl.gbss_ref_no,
                                   l_rowRefColour.product_number,
                                   l_rowWmsAttDtl.unitsperinner,
                                   l_rowWmsAttDtl.innersperouter,
                                   l_rowWmsAttDtl.unitsperouter,
                                   l_rowWmsAttDtl.unitspercbm,
                                   l_rowWmsAttDtl.outercartonheight,
                                   l_rowWmsAttDtl.outercartonwidth,
                                   l_rowWmsAttDtl.outercartonlength,
                                   l_rowWmsAttDtl.outercartoncbm,
                                   l_rowWmsAttDtl.outercartongrossweight,
                                   l_rowWmsAttDtl.innercartonheight,
                                   l_rowWmsAttDtl.innercartonwidth,
                                   l_rowWmsAttDtl.innercartonlength,
                                   l_rowWmsAttDtl.innercartoncbm,
                                   l_rowWmsAttDtl.innercartonweight,
                                   l_rowWmsAttDtl.deliveryunitdimensionsheight,
                                   l_rowWmsAttDtl.deliveryunitdimensionswidth,
                                   l_rowWmsAttDtl.deliveryunitdimensionslength,
                                   l_rowWmsAttDtl.deliveryunitdimprdtweight,
                                   l_rowWmsAttDtl.fragile,
                                   l_rowWmsAttDtl.temperaturecontrolled,
                                   l_rowWmsAttDtl.dangerousgoods,
                                   l_rowWmsAttDtl.dgclass,
                                   l_rowWmsAttDtl.hazmatnumber,
                                   l_rowWmsAttDtl.unnumber,
                                   l_rowWmsAttDtl.packaginggroup
                                   );

                            INSERT INTO tar_itrpcdee(prd_lvl_child,
                                                     prd_custom_description)
                            VALUES(l_nPrdLvlChild,
                                   l_rowWmsAttDtl.custom_desc
                                  );


                            INSERT INTO prdextee(prd_lvl_child,
                                                 unit_height,
                                                 unit_width,
                                                 unit_depth
                                                 )
                            VALUES(l_nPrdLvlChild,
                                    DECODE(SIGN(SUBSTR(l_rowWmsAttDtl.deliveryunitdimensionsheight, 0, INSTR(l_rowWmsAttDtl.deliveryunitdimensionsheight, '.') - 1) - 10000),
                                            1,
                                            SUBSTR(l_rowWmsAttDtl.deliveryunitdimensionsheight, 0, 4) || '.' ||
                                             SUBSTR(ROUND(l_rowWmsAttDtl.deliveryunitdimensionsheight, 3),
                                             INSTR(ROUND(l_rowWmsAttDtl.deliveryunitdimensionsheight, 3), '.', -1) + 1,
                                             LENGTH(ROUND(l_rowWmsAttDtl.deliveryunitdimensionsheight, 3)) -
                                             INSTR(ROUND(l_rowWmsAttDtl.deliveryunitdimensionsheight, 3), '.', -1)),
                                            ROUND(l_rowWmsAttDtl.deliveryunitdimensionsheight, 3)), -- height

                                    DECODE(SIGN(SUBSTR(l_rowWmsAttDtl.deliveryunitdimensionswidth, 0, INSTR(l_rowWmsAttDtl.deliveryunitdimensionswidth, '.') - 1) - 10000),
                                            1,
                                            SUBSTR(l_rowWmsAttDtl.deliveryunitdimensionswidth, 0, 4) || '.' ||
                                             SUBSTR(ROUND(l_rowWmsAttDtl.deliveryunitdimensionswidth, 3),
                                             INSTR(ROUND(l_rowWmsAttDtl.deliveryunitdimensionswidth, 3), '.', -1) + 1,
                                             LENGTH(ROUND(l_rowWmsAttDtl.deliveryunitdimensionswidth, 3)) -
                                             INSTR(ROUND(l_rowWmsAttDtl.deliveryunitdimensionswidth, 3), '.', -1)),
                                            ROUND(l_rowWmsAttDtl.deliveryunitdimensionswidth, 3)), --width

                                    DECODE(SIGN(SUBSTR(l_rowWmsAttDtl.deliveryunitdimensionslength, 0, INSTR(l_rowWmsAttDtl.deliveryunitdimensionslength, '.') - 1) - 10000),
                                            1,
                                            SUBSTR(l_rowWmsAttDtl.deliveryunitdimensionslength, 0, 4) || '.' ||
                                             SUBSTR(ROUND(l_rowWmsAttDtl.deliveryunitdimensionslength, 3),
                                             INSTR(ROUND(l_rowWmsAttDtl.deliveryunitdimensionslength, 3), '.', -1) + 1,
                                             LENGTH(ROUND(l_rowWmsAttDtl.deliveryunitdimensionslength, 3)) -
                                             INSTR(ROUND(l_rowWmsAttDtl.deliveryunitdimensionslength, 3), '.', -1)),
                                            ROUND(l_rowWmsAttDtl.deliveryunitdimensionslength, 3)) --depth
                                  );

                            INSERT INTO tar_prdextee(prd_lvl_child,
                                                     unit_weight
                                                    )
                            VALUES(l_nPrdLvlChild,
                                    DECODE(SIGN(SUBSTR(l_rowWmsAttDtl.deliveryunitdimprdtweight, 0, INSTR(l_rowWmsAttDtl.deliveryunitdimprdtweight, '.') - 1) - 10000),
                                            1,
                                            SUBSTR(l_rowWmsAttDtl.deliveryunitdimprdtweight, 0, 4) || '.' ||
                                             SUBSTR(ROUND(l_rowWmsAttDtl.deliveryunitdimprdtweight, 3),
                                             INSTR(ROUND(l_rowWmsAttDtl.deliveryunitdimprdtweight, 3), '.', -1) + 1,
                                             LENGTH(ROUND(l_rowWmsAttDtl.deliveryunitdimprdtweight, 3)) -
                                             INSTR(ROUND(l_rowWmsAttDtl.deliveryunitdimprdtweight, 3), '.', -1)),
                                            ROUND(l_rowWmsAttDtl.deliveryunitdimprdtweight, 3)) --weight
                                  );
                        END;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            dbms_output.put_line(LC_vPGMNAME || ': Product Number ' || l_rowRefColour.product_number || ' not found');
                    END;
                END LOOP;
            END;
        END LOOP;
        COMMIT;
    END p_LoadPrdWmsAtt;

    /************************************************************************
    *
    * NAME:        p_LoadWebDetails
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This procedure loads the web specific details of the product
    *                       into respective target tables.
    *
    * USAGE:       p_LoadWebDetails
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri       17/05/2013  Original Version.
    * Ronald Nava       05/07/2017  Modified XML query construct to improve performance
    * Ronald Nava       24/10/2017  Fixed aliases and cursor names.
    * Ronald Nava       03/06/2019  Added bug fix to address Oracle unpivot bug 14641856
    *************************************************************************/

    PROCEDURE p_LoadWebDetails(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE) IS

        /* Local Declarations */
        LC_vPGMNAME        CONSTANT VARCHAR2(20)                   := 'p_LoadWebDetails';
        LC_nPRD_NOT_FND    CONSTANT NUMBER(3)                      := 902;
        LC_cWEB_CODE_WPN   CONSTANT tar_webadhee.web_adh_code%TYPE := 'WPN';
        LC_cWEB_CODE_WPF   CONSTANT tar_webadhee.web_adh_code%TYPE := 'WPF';
        LC_cWEB_CODE_WBI   CONSTANT tar_webadhee.web_adh_code%TYPE := 'WBI';
        LC_cWEB_CODE_WTE   CONSTANT tar_webadhee.web_adh_code%TYPE := 'WTE';
        LC_cWEB_CODE_WOE   CONSTANT tar_webadhee.web_adh_code%TYPE := 'WOE';


        l_nLvl1Child                prdmstee.prd_lvl_child%TYPE;

        /* Main Cursor */

        CURSOR l_curRefColour IS
            SELECT gbss_ref_no,
                   colour_sequence,
                   product_number
            FROM   tar_gbss_sty_prd
            WHERE  upload_date IS NULL
            AND    sdi_reg_status = GC_cTRUE
            AND    batch_num = p_nSdiBatchNum;

        CURSOR l_curWebPrdVals(l_vGbssRefNo     IN VARCHAR2,
                              l_nColourSequence IN NUMBER) IS
            SELECT gbss_ref_no,
                   colour_sequence,
                   VALUE,
                   web_detail_type
            FROM   (SELECT xml.gbss_ref_no,
                           xml.colour_sequence,
                           xml.product_name,
                           xml.product_features,
                           DECODE(xml.target_exclusive,'Y','1','N','2',NULL) target_exclusive,
                           DECODE(xml.online_exclusive,'Y','1','N','2',NULL) online_exclusive,
                           DECODE(xml.bulky_item_delivery,'Y','1','N','2',NULL) bulky_item_delivery
                    FROM   tar_gbss_prd_file_store xfs,
                           XMLTABLE('for $i in /Brief/Colour
                                     return <row>
                                     {
                                         <colour_sequence>{$i/@seq/string()}</colour_sequence>,
                                         $i/../GBSSRefNo,
                                         $i/Keycode/WebProductName,
                                         $i/Keycode/ProductFeatures,
                                         $i/Keycode/TargetExclusive,
                                         $i/Keycode/OnlineExclusive,
                                         $i/Keycode/BulkyItemDelivery
                                     }
                                     </row>'
                                     PASSING xfs.filecontent
                                     COLUMNS gbss_ref_no         PATH 'GBSSRefNo',
                                             colour_sequence     PATH 'colour_sequence',
                                             product_name        PATH 'WebProductName',
                                             product_features    PATH 'ProductFeatures',
                                             target_exclusive    PATH 'TargetExclusive',
                                             online_exclusive    PATH 'OnlineExclusive',
                                             bulky_item_delivery PATH 'BulkyItemDelivery'
                                   ) xml
                    WHERE  xfs.batch_num = p_nSdiBatchNum
                    UNION ALL
                    SELECT '1' AS col1,
                           '2' AS col2,
                           '3' AS col3,
                           '4' AS col4,
                           '5' AS col5,
                           '6' AS col6,
                           '7' AS col7
                    FROM   DUAL
                    WHERE  1=2
                    ) xmltab
                    UNPIVOT (VALUE FOR web_detail_type IN
                                (product_name        AS 'WPN',
                                 product_features    AS 'WPF',
                                 target_exclusive    AS 'WTE',
                                 online_exclusive    AS 'WOE',
                                 bulky_item_delivery AS 'WBI')
                            )
             WHERE  gbss_ref_no = l_vGbssRefNo
             AND    colour_sequence = l_nColourSequence;

    BEGIN

        FOR l_rowRefColour IN l_curRefColour LOOP
            BEGIN
                FOR l_rowWebPrdVals IN l_curWebPrdVals(l_rowRefColour.gbss_ref_no,
                                                       l_rowRefColour.colour_sequence) LOOP

                    BEGIN
                        SELECT prd_lvl_child
                        INTO   l_nLvl1Child
                        FROM   prdmstee prd
                        WHERE  prd.prd_lvl_number = l_rowRefColour.product_number;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN

                            INSERT INTO tar_gbss_prd_sdi_upld_rej(script_name ,
                                                                  gbss_ref_no,
                                                                  product_number,
                                                                  colour_sequence,
                                                                  reason_code,
                                                                  comment1,
                                                                  comment2,
                                                                  comment3,
                                                                  error_date
                                                                  )
                            VALUES(LC_vPGMNAME,
                                   l_rowRefColour.gbss_ref_no,
                                   l_rowRefColour.product_number,
                                   l_rowRefColour.colour_sequence,
                                   LC_nPRD_NOT_FND,
                                   'product not found',
                                   NULL,
                                   NULL,
                                   SYSDATE);

                            UPDATE tar_gbss_sty_prd sty_prd
                            SET    sty_prd.overall_prd_reg_status = GC_cFALSE
                            WHERE  sty_prd.product_number         = l_rowRefColour.product_number
                            AND    sty_prd.batch_num = p_nSdiBatchNum;
                            EXIT;
                    END;
                    IF l_rowWebPrdVals.web_detail_type = 'WBI' OR
                       l_rowWebPrdVals.web_detail_type = 'WTE' OR
                       l_rowWebPrdVals.web_detail_type = 'WOE' THEN

                        INSERT INTO tar_webprdee(prd_lvl_child,
                                                 web_adh_code,
                                                 web_add_key,
                                                 web_add_value)
                        VALUES(l_nLvl1Child,
                               l_rowWebPrdVals.web_detail_type,
                               l_rowWebPrdVals.value,
                               NULL);
                        ELSE
                            INSERT INTO tar_webprdee(prd_lvl_child,
                                                     web_adh_code,
                                                     web_add_key,
                                                     web_add_value)
                            VALUES(l_nLvl1Child,
                                   l_rowWebPrdVals.web_detail_type,
                                   NULL,
                                   l_rowWebPrdVals.value);
                    END IF;
                END LOOP;
            EXCEPTION
                WHEN OTHERS THEN
                ROLLBACK WORK;
            END;
        END LOOP;

   END p_LoadWebDetails;

    /************************************************************************
    *
    * NAME:        f_overallstylestatus
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: Returns the overall status of the style that is used to build the ACK/ERR xml File.
    *
    * USAGE:      f_overallstylestatus
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri        17/05/2013   Original Version.
    *
    *************************************************************************/
    PROCEDURE p_OverallStyleStatus(p_vStyleNo IN tar_gbss_sty_prd.gbss_ref_no%TYPE,
                                   p_vStatus  OUT VARCHAR2) IS

        /* Local Declarations */
        LC_vPGMNAME          CONSTANT VARCHAR2(30) := 'p_OverallStyleStatus';
        LC_vSTATUS_SUCCESS   CONSTANT VARCHAR2(10) := 'SUCCESS';
        LC_vSTATUS_ERROR     CONSTANT VARCHAR2(10) := 'ERROR';
        l_vOverallStyleStatus         VARCHAR2(10);

        CURSOR l_curStatus IS
            SELECT DISTINCT sty_prd.overall_prd_reg_status
            FROM   tar_gbss_sty_prd sty_prd
            WHERE  sty_prd.gbss_ref_no = p_vStyleNo
            AND    upload_date IS NULL;

    BEGIN
        l_vOverallStyleStatus := LC_vSTATUS_SUCCESS;
        FOR l_rowStatus IN l_curStatus LOOP
            IF l_rowStatus.overall_prd_reg_status = GC_cTRUE AND l_vOverallStyleStatus = LC_vSTATUS_SUCCESS THEN
                l_vOverallStyleStatus := LC_vSTATUS_SUCCESS;
            ELSE
                l_vOverallStyleStatus := LC_vSTATUS_ERROR;

            END IF;
        END LOOP;

        p_vStatus := l_vOverallStyleStatus;
    EXCEPTION
        WHEN OTHERS THEN
            dbms_output.put_line('Error in '|| LC_vPGMNAME ||': '||SQLCODE ||' - '|| SQLERRM);
            ROLLBACK;
            RAISE;

    END p_OverallStyleStatus;

    /************************************************************************
    *
    * NAME:        p_DeleteFailProcessing
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This procedure deletes the sdi data for product whoes sdiprdba generates error
    *
    * USAGE:      p_DeleteFailProcessing
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri        17/05/2013   Original Version.
    *
    *************************************************************************/
    PROCEDURE p_DeleteFailProcessing(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE) AS

        /* Local Declarations */
        LC_vPGMNAME      CONSTANT VARCHAR2(30) := 'p_DeleteFailProcessing';
        l_iHdrAttFail             PLS_INTEGER;
        l_iAddFail                PLS_INTEGER;

        CURSOR l_curRefColour IS
            SELECT gbss_ref_no,
                   colour_sequence,
                   product_number
            FROM   tar_gbss_sty_prd
            WHERE  upload_date    IS NULL
            AND    upload_to_base IS NULL
            AND    sdi_reg_status IS NULL
            AND    batch_num = p_nSdiBatchNum;

    BEGIN

        FOR l_rowRefColour IN l_curRefColour LOOP
            SELECT COUNT(*)
            INTO   l_iHdrAttFail
            FROM   sdiprdmsi hdr_att
            WHERE  hdr_att.prd_lvl_number = l_rowRefColour.product_number
            AND    hdr_att.error_code     IS NOT NULL
            AND    hdr_att.batch_num      = p_nSdiBatchNum;

            SELECT COUNT(*)
            INTO   l_iAddFail
            FROM   sdivalmsi ad
            WHERE  ad.prd_lvl_number = l_rowRefColour.product_number
            AND    ad.val_err_code   IS NOT NULL;

            IF l_iHdrAttFail > 0 OR l_iAddFail > 0 THEN

                DELETE sdivpccsi
                WHERE  prd_lvl_number = l_rowRefColour.product_number
                AND    batch_num      = p_nSdiBatchNum;

                DELETE prdprcee
                WHERE  prd_lvl_number = l_rowRefColour.product_number
                AND    batch_num      = p_nSdiBatchNum;

                DELETE sdiprddsi
                WHERE  prd_lvl_number = l_rowRefColour.product_number
                AND    batch_num      = p_nSdiBatchNum;

            END IF;
        END LOOP;
    END p_DeleteFailProcessing;

    /************************************************************************
    *
    * NAME:        p_LoadCostingToSdi
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This procedure loads the cost info into the processing layer prdcstee
    *
    * USAGE:      p_LoadCostingToSdi
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri       17/05/2013  Original Version.
    * Brett Rees        04/04/2014  Don't divide cost from GBSS by casepack qty
    * Nisa Basheer      01/08/2014  Colour level costing- CR16B
    * Ronald Nava       05/07/2017  Modified XML query construct to improve performance
    * Ronald Nava       24/10/2017  Fixed aliases and cursor names.
    *************************************************************************/

    PROCEDURE p_LoadCostingToSdi(p_nSdiBatchNum IN prdcstee.batch_num%TYPE) IS

        /* Local Declarations */
        LC_vPGMNAME    CONSTANT VARCHAR2(30) := 'p_LoadCostingToSdi';

        l_nPrdLvlChild          prdmstee.prd_lvl_child%TYPE;
        l_nPrimQty              vpcprdee.vpc_case_qty%TYPE;
        l_nCost                 prdprcee.prd_prc_price%TYPE;
        l_dtCalDate             caldayee.caldat%TYPE;

        /* main cursor */
        CURSOR l_curRefCol IS
            SELECT sty_prd.product_number,
                   sty_prd.gbss_ref_no,
                   sty_prd.colour_sequence
            FROM   tar_gbss_sty_prd sty_prd
            WHERE  sty_prd.sdi_reg_status = GC_cTRUE
            AND    upload_date IS NULL
            AND    sty_prd.batch_num = p_nSdiBatchNum;

        /* Cost types */

        CURSOR l_curCstType IS
            SELECT cap_chain_id
            FROM   csttypee;

        /* costing value from xml */
        CURSOR l_curCst(l_vgbssrefno tar_gbss_sty_prd.gbss_ref_no%TYPE,
                        l_vseqno     tar_gbss_sty_prd.colour_sequence%TYPE) IS
            SELECT DISTINCT xml.est_lnd_cst_ex_gst
            FROM   tar_gbss_prd_file_store xfs,
                   XMLTABLE('for $i in /Brief/Colour
                             return <row>
                             {
                                  <colour_sequence>{$i/@seq/string()}</colour_sequence>,
                                  $i/../GBSSRefNo,
                                  $i/EstELCAUD
                             }
                             </row>'
                             PASSING xfs.filecontent
                             COLUMNS
                                     gbss_ref_no        PATH 'GBSSRefNo',
                                     colour_sequence    PATH 'colour_sequence',
                                     est_lnd_cst_ex_gst PATH 'EstELCAUD'
                           ) xml
            WHERE  xml.gbss_ref_no     = l_vgbssrefno
            AND    xml.colour_sequence = l_vseqno
            AND    xfs.batch_num       = p_nSdiBatchNum;

    BEGIN

        /* Get cal date */
        SELECT caldat
        INTO l_dtCalDate
        FROM caldayee;

        FOR l_rowRefCol IN l_curRefCol LOOP
            BEGIN
                /* get prd_lvl_child and case qty for the primary case of a  product */
                SELECT pmst.prd_lvl_child,
                       vprd.vpc_case_qty
                INTO   l_nPrdLvlChild,
                       l_nPrimQty
                FROM   prdmstee pmst,
                       vpcprdee vprd
                WHERE  pmst.prd_lvl_child    = vprd.prd_lvl_child
                AND    vprd.vpc_primary_flag = GC_cTRUE
                AND    pmst.prd_lvl_number   = l_rowRefCol.product_number;

                FOR l_rowCstType IN l_curCstType LOOP
                    OPEN l_curCst(l_rowRefCol.gbss_ref_no,
                                  l_rowRefCol.colour_sequence);
                    FETCH l_curCst
                    INTO  l_nCost;
                    INSERT INTO prdcstee(batch_num,
                                         prd_lvl_child,
                                         prd_lvl_number,
                                         cap_chain_id,
                                         prd_eff_date,
                                         prd_cost,
                                         proc_by_cost)
                    VALUES(p_nSdiBatchNum,
                           l_nPrdLvlChild,
                           l_rowRefCol.product_number,
                           l_rowCstType.cap_chain_id,
                           l_dtCalDate - 1,
                           l_nCost,
                           GC_cTRUE);
                    CLOSE l_curCst;
                END LOOP;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    dbms_output.put_line('No primary case pack defined for this product');
            END;
        END LOOP;
    EXCEPTION
        WHEN OTHERS THEN
            ROLLBACK;
            dbms_output.put_line('Error in '|| LC_vPGMNAME ||': '||SQLCODE ||' - '|| SQLERRM);
            RAISE;
    END p_LoadCostingToSdi;

    /************************************************************************
    *
    * NAME:        p_LoadStyleToRange
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This procedure loads the Styel against the range tar_prdstcsee
    *
    * USAGE:      p_LoadStyleToRange
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri        17/05/2013   Original Version.
    * Grant Whiteside    05/11/2013  Modify for Standards.
    * Brett Rees         14/11/2013  Fix range number insert into tar_prdstlee (was using prd_lvl_number instead)
    * Brett Rees         02/01/2014  Restrict query to only check lvl 2 for range number. Fixed style placeholder not populating
    * Brett Rees         08/01/2014  QA change
    * Nisa Basheer       22/01/2014  limiting style place holder number value to 18.
    *
    *************************************************************************/

    PROCEDURE p_LoadStyleToRange(p_nSdiBatchNum IN prdcstee.batch_num%TYPE) IS

        /* Local Declarations */
        LC_vPGMNAME        CONSTANT VARCHAR2(30)             := 'p_LoadStyleToRange';
        LC_cNO             CONSTANT CHAR(1)                  := 'N';
        LC_nPRD_LVL_ID_RNG CONSTANT prdmstee.prd_lvl_id%TYPE := 2;

        /* Cursors */

         CURSOR l_curStyPrd IS
             SELECT DISTINCT sty_prd.gbss_ref_no
             FROM   tar_gbss_sty_prd sty_prd
             WHERE  sty_prd.sdi_reg_status  = GC_cTRUE
             AND    upload_date            IS NULL
             AND    sty_prd.batch_num = p_nSdiBatchNum;

    BEGIN
        FOR l_rowStyPrd IN l_curStyPrd LOOP
            BEGIN
                MERGE INTO tar_prdstlee tar_sty
                USING (SELECT ref_no.gbss_ref_number    style_number,
                              rng.prd_lvl_child         prd_lvl_parent,
                              SUBSTR(style_desc,0,30)   style_description,
                              SUBSTR(ref_no.style_placeholder,0,18)  style_placeholder
                       FROM   tar_gbss_prd_file_store xfs,
                              prdmstee                rng,
                              xmltable('/Brief'             passing xfs.filecontent COLUMNS
                                        header_item xmltype path 'Header',
                                        gbss_ref_number     path 'GBSSRefNo',
                                        style_desc          path 'ItemStyleDesc',
                                        range_no            path 'Range',
                                        style_placeholder   path 'StylePlaceholderNo'
                                       ) ref_no
                       WHERE  ref_no.gbss_ref_number         = l_rowStyPrd.gbss_ref_no
                       AND    RPAD(ref_no.range_no, 15, ' ') = rng.prd_lvl_number
                       AND    rng.prd_lvl_id                 = LC_nPRD_LVL_ID_RNG
                       AND    xfs.batch_num = p_nSdiBatchNum
                       ) qst
                ON     (tar_sty.style_number   = qst.style_number
                AND     tar_sty.prd_lvl_parent = qst.prd_lvl_parent)
                WHEN MATCHED THEN
                    UPDATE SET style_active = LC_cNO
                WHEN NOT MATCHED THEN
                    INSERT(tar_sty.style_number,
                           style_description,
                           style_active,
                           prd_lvl_parent,
                           place_holder
                          )
                    VALUES (qst.style_number,
                            qst.style_description,
                            LC_cNO,
                            qst.prd_lvl_parent,
                            qst.style_placeholder
                           );
            END;
        END LOOP;
    END p_LoadStyleToRange;
    /************************************************************************
    *
    * NAME:        p_LoadAssortment
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This procedure loads the assortment details from the XML file
    *
    * USAGE:       p_LoadAssortment
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri       17/05/2013  Original Version.
    * Grant Whiteside   05/11/2013  Modify for Standards.
    * Nisa Basheer      30/05/2014  Incorporate Multiple assortment plans.
    * Nisa Basheer      19-11-2014  Online assortment issue SCR13043.
    * Ronald Nava       05/07/2017  Modified XML query construct to improve performance
    * Ronald Nava       11/09/2017  Assortment Plan bug fix
    * Ronald Nava       24/10/2017  Fixed aliases and cursor names.
    *************************************************************************/
    PROCEDURE p_LoadAssortment(p_nSdiBatchNum IN prdcstee.batch_num%TYPE) IS

        /* Local Declarations */
        LC_vTARGET_ONL_ATT_TYPE     CONSTANT  basahree.atr_header_desc%TYPE := 'Target On-Line';
        LC_cTARG_ONLINE_PLAN        CONSTANT  prdaphee.prd_aph_code%TYPE    := 'TONL';
        LC_cYES                     CONSTANT  CHAR(3)                       := 'YES';
        LC_cERRCODE_AST_FAIL        CONSTANT  CHAR(3)                       := '222';
        LC_vPGMNAME                 CONSTANT  VARCHAR2(30)                  := 'p_LoadAssortment';

        l_nTonlKey                            prdaphee.prd_aph_key%TYPE;
        l_nPrdLvlChild                        prdmstee.prd_lvl_child%TYPE;
        l_cOnlineCode                         basacdee.atr_code%TYPE;
        l_nOnlineCode                         prdaphee.prd_aph_key%TYPE;

    /* cursors */
    CURSOR l_curGetRefCol IS
        SELECT DISTINCT sty_prd.gbss_ref_no,
               colour_sequence,
               product_number
        FROM   tar_gbss_sty_prd sty_prd
        WHERE  sty_prd.sdi_reg_status = GC_cTRUE
        AND    upload_date IS NULL
        AND    sty_prd.batch_num = p_nSdiBatchNum;

    /* assortment cursor */
    CURSOR l_curAssortment(l_vGbssRefNo      IN VARCHAR2,
                           l_nColourSequence IN NUMBER) IS
        SELECT xml.gbss_ref_no,
               xml.colour_sequence,
               TRIM(xml.assortment_plan) assortment_plan
        FROM   tar_gbss_prd_file_store xfs,
               XMLTABLE('for $i in /Brief/Colour/Keycode/AssortmentPlan
                         return <row>
                         {
                              <colour_sequence>{$i/../../@seq/string()}</colour_sequence>,
                              $i/../../../GBSSRefNo,
                              <assortment_plan>{$i/string()}</assortment_plan>
                         }
                         </row>'
                         PASSING xfs.filecontent
                         COLUMNS
                                 gbss_ref_no     PATH 'GBSSRefNo',
                                 colour_sequence PATH 'colour_sequence',
                                 assortment_plan PATH 'assortment_plan'
                       ) xml
        WHERE  xml.assortment_plan                  IS NOT NULL
        AND    TO_NUMBER(TRIM(xml.assortment_plan)) <> l_nTonlKey
        AND    gbss_ref_no                          = l_vGbssRefNo
        AND    colour_sequence                      = l_nColourSequence
        AND    xfs.batch_num                        = p_nSdiBatchNum;

    BEGIN
        /* Get Target ONLINE Key */
        SELECT aph.prd_aph_key
        INTO   l_nTonlKey
        FROM   prdaphee aph
        WHERE  aph.prd_aph_code = LC_cTARG_ONLINE_PLAN;


        FOR l_rowGetRefCol IN l_curGetRefCol LOOP
            BEGIN
                FOR l_rowAssortment IN l_curAssortment(l_rowGetRefCol.gbss_ref_no,
                                                       l_rowGetRefCol.colour_sequence) LOOP

                 /* Get the prd lvl child */
                    BEGIN
                        SELECT prd_lvl_child
                        INTO   l_nPrdLvlChild
                        FROM   prdmstee pmst
                        WHERE  pmst.prd_lvl_number = l_rowGetRefCol.product_number;

                        INSERT INTO prdapdee (prd_aph_key,
                                              prd_lvl_child
                                             )
                        VALUES(l_rowAssortment.assortment_plan,
                               l_nPrdLvlChild
                              );

                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN

                        INSERT INTO tar_gbss_prd_sdi_upld_rej (script_name,
                                                               gbss_ref_no,
                                                               product_number,
                                                               reason_code,
                                                               comment1
                                                              )
                        VALUES('p_LoadAssortment',
                                l_rowGetRefCol.gbss_ref_no,
                                l_rowGetRefCol.product_number,
                                LC_cERRCODE_AST_FAIL,
                                'Assortment build failed'
                               );

                        UPDATE tar_gbss_sty_prd sty_prd
                        SET    sty_prd.sdi_reg_status = GC_cFALSE
                        WHERE  sty_prd.product_number = l_rowGetRefCol.product_number
                        AND    sty_prd.batch_num = p_nSdiBatchNum;

                    END;
                END LOOP;
             /* Check if we need to also asign TONL for assortment based on the value selected in */

                SELECT cde.atr_code
                INTO   l_cOnlineCode
                FROM   basacdee cde,
                       basahree hdr,
                       basatpee atp,
                       prdmstee prd
                WHERE  cde.atr_hdr_tech_key   = hdr.atr_hdr_tech_key
                AND    hdr.atr_header_desc    = LC_vTARGET_ONL_ATT_TYPE
                AND    atp.atr_cod_tech_key   = cde.atr_cod_tech_key
                AND    atp.prd_lvl_child      = prd.prd_lvl_child
                AND    prd.prd_lvl_number     = l_rowGetRefCol.product_number;

               IF TRIM(l_cOnlineCode) = LC_cYES THEN
                   SELECT aph.prd_aph_key
                   INTO   l_nOnlineCode
                   FROM   prdaphee aph
                   WHERE  aph.prd_aph_code = LC_cTARG_ONLINE_PLAN;

                   /* Get the prd lvl child SCR13043*/
                   SELECT prd_lvl_child
                   INTO   l_nPrdLvlChild
                   FROM   prdmstee pmst
                   WHERE  pmst.prd_lvl_number = l_rowGetRefCol.product_number;

                   INSERT INTO prdapdee (prd_aph_key,
                                         prd_lvl_child
                                         )
                   VALUES(l_nOnlineCode,
                          l_nPrdLvlChild
                          );
               END IF;
            EXCEPTION
                WHEN OTHERS THEN
                    ROLLBACK WORK;
                    dbms_output.put_line('Error in '|| LC_vPGMNAME ||': '||SQLCODE ||' - '|| SQLERRM);
                    RAISE;

            END;
        END LOOP;
        COMMIT;

    END p_LoadAssortment;

    /************************************************************************
    *
    * NAME:        p_SetInactiveVariations
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This procedure will set inactive variations from the product registration file
    *
    * USAGE:       p_SetInactiveVariations
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Brett Rees        18/11/2013  Original Version.
    * Nisa Basheer      01/12/2014  Invalid dimension SCR 13078
    * Nisa Basheer      20/10/2016  Set Product and variation status to NCA
    *                               when the size is inactive GE-504.
    * Ronald Nava       14/08/2017  Modified XML query construct to improve performance
    * Ronald Nava       11/09/2017  Further XML query tuning
    * Ronald Nava       24/10/2017  Fixed aliases and cursor names.
    * Ronald Nava       15/02/2018  Split the cursor and update statements.
	* Ronald Nava       23/02/2018  Added 6 spaces
    *************************************************************************/
    PROCEDURE p_SetInactiveVariations (p_nSdiBatchNum IN prdcstee.batch_num%TYPE)

    IS

        /* Local Declarations */
        LC_cPGMNAME           CONSTANT VARCHAR2(30) := 'p_SetInactiveVariations';
        LC_vSIZE_INACTIVE     CONSTANT VARCHAR2(8)  := 'Inactive';
        LC_nPRD_STATUS_NCA    CONSTANT NUMBER(1)    := 6;

        /* Cursors */
        CURSOR l_curGbssColSz IS
            SELECT pdx.prd_lvl_child,
                   xmlcs.sizStatus
            FROM   tar_gbss_prd_file_store xfs,
                   tar_gbss_sty_prd sty,
                   prdmstee prd,
                   prdpdxee pdx,
                   prddmdee dmd,
                   XMLTABLE('for $i in /Brief/Colour/ColourSize
                             return <row>
                             {
                                  $i/../../GBSSRefNo,
                                  <colour_sequence>{$i/../@seq/string()}</colour_sequence>,
                                  $i/Status,
                                  $i/SizeSeq,
                                  <prd_pdd_code>{$i/@code/string()}</prd_pdd_code>
                             }
                             </row>'
                             PASSING xfs.filecontent
                             COLUMNS gbss_ref_no     PATH 'GBSSRefNo',
                                     colour_sequence PATH 'colour_sequence',
                                     sizStatus       PATH 'Status',
                                     sizeSeq         PATH 'SizeSeq',
                                     prd_pdd_code    PATH 'prd_pdd_code'
                           ) xmlcs
            WHERE  xfs.batch_num         = p_nSdiBatchNum
            AND    sty.gbss_ref_no       = xmlcs.gbss_ref_no
            AND    sty.colour_sequence   = xmlcs.colour_sequence
            AND    sty.sdi_reg_status    = GC_cTRUE
            AND    sty.upload_date       IS NULL
            AND    sty.prd_lvl_child     = prd.prd_lvl_parent
            AND    prd.prd_lvl_child     = pdx.prd_lvl_child
            AND    pdx.prd_pdd_key       = dmd.prd_pdd_key
            AND    xmlcs.prd_pdd_code    = TRIM(dmd.prd_pdd_code)
            AND    xmlcs.sizStatus       = LC_vSIZE_INACTIVE;

        CURSOR l_curGbssSz IS
            SELECT pdx.prd_lvl_child,
                   xmlsz.status
            FROM   tar_gbss_prd_file_store xfs,
                   tar_gbss_sty_prd sty,
                   prdmstee prd,
                   prdpdxee pdx,
                   prddmdee dmd,
                   XMLTABLE('for $i in /Brief/Size
                             return <row>
                             {
                                  $i/../GBSSRefNo,
                                  <prd_pdd_code>{$i/@code/string()}</prd_pdd_code>,
                                  $i/Status,
                                  $i/SizeSeq
                             }
                             </row>'
                             PASSING xfs.filecontent
                             COLUMNS gbss_ref_no     PATH 'GBSSRefNo',
                                     prd_pdd_code    PATH 'prd_pdd_code',
                                     status          PATH 'Status',
                                     size_seq        PATH 'SizeSeq'
                           ) xmlsz
            WHERE  xfs.batch_num         = p_nSdiBatchNum
            AND    sty.gbss_ref_no       = xmlsz.gbss_ref_no
            AND    sty.sdi_reg_status    = GC_cTRUE
            AND    sty.upload_date       IS NULL
            AND    sty.prd_lvl_child     = prd.prd_lvl_parent
            AND    prd.prd_lvl_child     = pdx.prd_lvl_child
            AND    pdx.prd_pdd_key       = dmd.prd_pdd_key
            AND    xmlsz.prd_pdd_code    = TRIM(dmd.prd_pdd_code)
            AND    xmlsz.status          = LC_vSIZE_INACTIVE;


    BEGIN
        FOR l_rowGbssColSz IN l_curGbssColSz LOOP

            UPDATE prdpdxee
            SET    prd_pdd_not   = GC_cFALSE
            WHERE  prd_lvl_child = l_rowGbssColSz.prd_lvl_child;

            --set the variation status to NCA
            UPDATE prdmstee
            SET    prd_status = LC_nPRD_STATUS_NCA
            WHERE  prd_lvl_child = l_rowGbssColSz.prd_lvl_child;

            --set the Casepack status to NCA
            UPDATE vpcprdee
            SET    vpc_prd_status = LC_nPRD_STATUS_NCA
            WHERE  prd_lvl_child = l_rowGbssColSz.prd_lvl_child;

        END LOOP;

        FOR l_rowGbssSz IN l_curGbssSz LOOP

            UPDATE prdpdxee
            SET    prd_pdd_not   = GC_cFALSE
            WHERE  prd_lvl_child = l_rowGbssSz.prd_lvl_child;

            --set the variation status to NCA
            UPDATE prdmstee
            SET    prd_status = LC_nPRD_STATUS_NCA
            WHERE  prd_lvl_child = l_rowGbssSz.prd_lvl_child;

            --set the Casepack status to NCA
            UPDATE vpcprdee
            SET    vpc_prd_status = LC_nPRD_STATUS_NCA
            WHERE  prd_lvl_child = l_rowGbssSz.prd_lvl_child;

        END LOOP;
    END p_SetInactiveVariations;


    /************************************************************************
    *
    * NAME:        p_OverallPrdRegStatus
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This procedure gives the overall pro reg status
    *
    * USAGE:      p_OverallPrdRegStatus
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Mohit Sikri       17/05/2013  Original Version.
    * Grant Whiteside   05/11/2013  Modify for Standards
    * Brett Rees        21/01/2013  Removed restriction on tar_gbss_prd_sdi_upld_rej errors
    * Brett Rees        23/01/2013  Clean up APN on failed products
    * Nisa Basheer      18/12/2013  Clean sdi layers of failed products to
    *                               avoid partial products in ODBMS.
    * Nisa Basheer      31-12-2014  Error Handling.
    * Nisa Basheer      20-01-2014  Removed delete to sdi layers as it is not necessary
    * Nisa Basheer      03-05-2014  Remove Force refresh code.
    *************************************************************************/

    PROCEDURE p_OverallPrdRegStatus(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE) IS

        /* Local Declarations */
        LC_vPGMNAME        CONSTANT VARCHAR2(30) := 'p_OverallPrdRegStatus';
        LC_nLvlID          CONSTANT NUMBER(1)    := 1;

        l_iMscErrors                PLS_INTEGER  := 0;
        l_iSdiError                 PLS_INTEGER  := 0;
        l_iPrdLvlChild              PLS_INTEGER  := 0;

        l_nPrdLvlChild              prdmstee.prd_lvl_child%TYPE;
        /* CURSORS */
        CURSOR l_curStyPrd IS
        SELECT gbss_ref_no,
               colour_sequence,
               product_number
        FROM   tar_gbss_sty_prd
        WHERE  upload_date IS NULL
        AND    batch_num = p_nSdiBatchNum;

    BEGIN
        FOR g_rowStyPrd IN l_curStyPrd LOOP
            BEGIN
                SELECT COUNT(*)
                INTO   l_iSdiError
                FROM   tar_gbss_sty_prd sty_prd
                WHERE  sty_prd.product_number = g_rowStyPrd.product_number
                AND    sty_prd.sdi_reg_status = GC_cFALSE
                AND    sty_prd.batch_num = p_nSdiBatchNum;

                IF l_iSdiError = GC_nZERO THEN
                    SELECT COUNT(*)
                    INTO   l_iMscErrors
                    FROM   tar_gbss_prd_sdi_upld_rej mr
                    WHERE  mr.product_number = g_rowStyPrd.product_number;
                END IF;

                IF l_iSdiError  >= 1 OR l_iMscErrors >= 1 THEN
                    UPDATE tar_gbss_sty_prd sty_prd
                    SET    sty_prd.overall_prd_reg_status = GC_cFALSE
                    WHERE  sty_prd.product_number         = g_rowStyPrd.product_number
                    AND    sty_prd.batch_num = p_nSdiBatchNum;


                    --Cleanup leftover APNs on failed keycode
                    DELETE prdupcee upc
                    WHERE  upc.prd_lvl_child IN (SELECT DECODE(sty.no_sizes, GC_cTRUE, prd.prd_lvl_child, vtn.prd_lvl_child)
                                                 FROM   prdmstee prd,
                                                        prdmstee vtn,
                                                        tar_gbss_sty_prd sty
                                                 WHERE  sty.product_number    = g_rowStyPrd.product_number
                                                 AND    sty.product_number    = prd.prd_lvl_number
                                                 AND    vtn.prd_lvl_parent(+) = prd.prd_lvl_child
                                                 AND    sty.batch_num = p_nSdiBatchNum);


                    /* Get the prd lvl child*/

                   SELECT count(*)
                   INTO   l_iPrdLvlChild
                   FROM   prdmstee pmst
                   WHERE  pmst.prd_lvl_number = g_rowStyPrd.product_number;

                   IF l_iPrdLvlChild  > 0 THEN
                       SELECT prd_lvl_child
                       INTO   l_nPrdLvlChild
                       FROM   prdmstee pmst
                       WHERE  pmst.prd_lvl_number = g_rowStyPrd.product_number;
                        /* Clean ODBMS for the failed product */
                        prdaddbat(l_nPrdLvlChild, g_rowStyPrd.product_number,LC_nLvlID);
                   END IF;

                 ELSE
                    UPDATE tar_gbss_sty_prd sty_prd
                    SET    sty_prd.overall_prd_reg_status = GC_cTRUE
                    WHERE  sty_prd.product_number         = g_rowStyPrd.product_number
                    AND    sty_prd.batch_num = p_nSdiBatchNum;
                END IF;
            END;
        END LOOP;
        COMMIT;

    EXCEPTION
        WHEN OTHERS THEN
            ROLLBACK;
            dbms_output.put_line('Error in '|| LC_vPGMNAME ||': '||SQLCODE ||' - '|| SQLERRM);
            RAISE;

    END p_OverallPrdRegStatus;

    /************************************************************************
    *
    * NAME:        p_LoadSkuType
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This procedure loads the sku type (named Product Type in GBSS)
    *
    * USAGE:       p_LoadSkuType
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Brett Rees        06/01/2014  Original Version.
    * Brett Rees        22/01/2014  Fix failed colour sequence being re-processed
    * Ronald Nava       14/08/2017  Modified XML query construct to improve performance
    * Ronald Nava       24/10/2017  Fixed aliases and cursor names.
    *
    *************************************************************************/
    PROCEDURE p_LoadSkuType(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE) IS

        /* Local Declarations */
        LC_vPGMNAME                CONSTANT VARCHAR2(30) := 'p_LoadSkuType';

        LC_cSKU_TYPE_CODE_REG      CONSTANT CHAR(3)      := 'REG';
        LC_cSKU_TYPE_CODE_SUND     CONSTANT CHAR(4)      := 'SUND';
        LC_cSKU_TYPE_CODE_CONS     CONSTANT CHAR(4)      := 'CONS';

        LC_nSKU_TYPE_REG           CONSTANT NUMBER(1)    := 1;
        LC_nSKU_TYPE_SUND          CONSTANT NUMBER(1)    := 2;
        LC_nSKU_TYPE_CONS          CONSTANT NUMBER(1)    := 3;

        l_dtCalDate                caldayee.caldat%TYPE;

        /* Cursors */
        CURSOR l_curGetRefCol IS
            SELECT sty.gbss_ref_no,
                   sty.colour_sequence
            FROM   tar_gbss_sty_prd sty
            WHERE  sty.sdi_reg_status = GC_cTRUE
            AND    sty.upload_date    IS NULL
            AND    sty.batch_num = p_nSdiBatchNum;

        CURSOR l_curSkuType(p_vGbssRefNo IN tar_gbss_sty_prd.gbss_ref_no%TYPE,
                            p_nColourSeq IN tar_gbss_sty_prd.colour_sequence%TYPE) IS
            SELECT DISTINCT DECODE(xml.product_type, LC_cSKU_TYPE_CODE_REG,  LC_nSKU_TYPE_REG,
                                                     LC_cSKU_TYPE_CODE_SUND, LC_nSKU_TYPE_SUND,
                                                     LC_cSKU_TYPE_CODE_CONS, LC_nSKU_TYPE_CONS) AS sku_type,
                   sty.prd_lvl_child
            FROM   tar_gbss_prd_file_store xfs,
                   tar_gbss_sty_prd        sty,
                   XMLTABLE('for $i in /Brief/Colour
                             return <row>
                             {
                                  $i/../GBSSRefNo,
                                  <colour_sequence>{$i/@seq/string()}</colour_sequence>,
                                  $i/Keycode/ProductType
                             }
                             </row>'
                             PASSING xfs.filecontent
                             COLUMNS gbss_ref_no     PATH 'GBSSRefNo',
                                     colour_sequence PATH 'colour_sequence',
                                     product_type    PATH 'ProductType'
                           ) xml
            WHERE  sty.upload_date     IS NULL
            AND    sty.sdi_reg_status  = GC_cTRUE
            AND    xml.gbss_ref_no     = sty.gbss_ref_no
            AND    sty.gbss_ref_no     = p_vGbssRefNo
            AND    xml.colour_sequence = sty.colour_sequence
            AND    sty.colour_sequence = p_nColourSeq
            AND    sty.batch_num       = p_nSdiBatchNum;

    BEGIN

        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vstart);

        /* Get ODBMS Merch date */
        SELECT caldat
        INTO   l_dtCalDate
        FROM   caldayee;

        FOR l_rowGetRefCol IN l_curGetRefCol LOOP
            FOR l_rowSkuType IN l_curSkuType(l_rowGetRefCol.Gbss_Ref_No, l_rowGetRefCol.Colour_Sequence) LOOP
                INSERT INTO tar_prdtypee(prd_lvl_child,
                                         typ_effect_date,
                                         typ_tech_key)
                VALUES(l_rowSkuType.prd_lvl_child,
                       l_dtCalDate,
                       l_rowSkuType.sku_type);

                INSERT INTO tar_prddtlee(prd_lvl_child,
                                         typ_effect_date,
                                         typ_tech_key)
                VALUES(l_rowSkuType.prd_lvl_child,
                       l_dtCalDate,
                       l_rowSkuType.sku_type);
            END LOOP;
        END LOOP;

        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vend);

    END p_LoadSkuType;
    /************************************************************************
    *
    * NAME:        p_UpdateCasepacksWithCBMandWGT
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This Procedure will update the case packs with weight and cbm
    *                        frome product registration files received from GBSS system.
    *
    * USAGE:      p_UpdateCasepacksWithCBMandWGT
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Nisa Basheer      31-07-2014  Initial Revision
    * Jay Rudhrasenan   08-10-2014  Added SUBSTR to vpc_case_desc value to have ony 40 chars
    * Jay Rudhrasenan   14-10-2014  Default cbm to 0.001 if the value is less than 0.001
    * Brett Rees        15-10-2014  Fixed standards
    * Nisa Basheer      25-06-2015  Added exception Handling since the product
                                       registration was failing due to Vendor Ordering change
                                       made by RAM in ODBMS.
    * Nisa Basheer      17-02-2016  Case Pack Redesign CR191
    * Ronald Nava       14/08/2017  Modified XML query construct to improve performance
    * Ronald Nava       24/10/2017  Fixed aliases and cursor names.
    * Ronald Nava       05/03/2018  Added RR Flag for ratio pack replen project
    *************************************************************************/

    PROCEDURE p_UpdateCasepacksWithCBMandWGT (p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE) IS

        /* Local Declarations */
        LC_vPGMNAME          CONSTANT VARCHAR2(60)                          := 'tar_gbss_prd_file_loading.p_UpdateCasepacksWithCBMandWGT';
        LC_vWT_UOM           CONSTANT VARCHAR2(3)                           := 'KG';
        LC_vDIM_UOM          CONSTANT VARCHAR2(3)                           := 'MTR';
        LC_nMIN_CBM          CONSTANT NUMBER(4,3)                           := 0.001;

        l_iRecCount                   PLS_INTEGER                           := 0;
        l_nPrdLvlId                   sdiprdmsi.prd_lvl_id%TYPE             := 1;
        l_nPrdStatus                  prdmstee.prd_status%TYPE;
        l_vGbssRefNo                  tar_gbss_sty_prd.gbss_ref_no%TYPE;
        l_nColourSequence             tar_gbss_sty_prd.colour_sequence%TYPE;
        l_cStyleFlag                  prdmstee.prd_style_ind%TYPE;
        l_nCbm                        NUMBER(16,6);


        /* CURSOR's */
        /* Main Cursor */
        CURSOR l_curGetRefCol IS
            SELECT gbss_ref_no,
                   colour_sequence,
                   product_number
            FROM   tar_gbss_sty_prd
            WHERE  upload_date    IS NULL
            AND    upload_to_base   IS NULL
            AND    batch_num = p_nSdiBatchNum;


        /* Cursor at Case pack level for every colour to get the cbm and weight*/
        CURSOR l_curColCaseQty(l_vGbssRefNo      IN VARCHAR2,
                               l_nColourSequence IN NUMBER) IS
            SELECT gbss_ref_no,
                   colour_sequence,
                   case_qty,
                   case_min_qty,
                   case_cbm,
                   case_gwt,
                   gbss_case_id,
                   case_desc,
                   unit_cost,
                   ratiopk_repln_flag
            FROM   (SELECT DISTINCT xml.gbss_ref_no,
                           xml.colour_sequence,
                           xml.case_qty,
                           xml.case_min_qty,
                           xml.case_cbm,
                           xml.case_gwt,
                           xml.unit_cost,
                           xml.packtype gbss_case_id,
                           xml.case_desc,
                           xml.ratiopk_repln_flag
                    FROM   tar_gbss_prd_file_store xfs,
                           XMLTABLE('for $i in /Brief/Colour/Pack
                                     return <row>
                                     {
                                          $i/../../GBSSRefNo,
                                          <colour_sequence>{$i/../@seq/string()}</colour_sequence>,
                                          <packtype>{$i/@type/string()}</packtype>,
                                          $i/PackQty,
                                          $i/PackMinQty,
                                          $i/PackCBM,
                                          $i/PackGrossWeight,
                                          $i/../VendorUnitCost,
                                          $i/../Keycode/ProductName,
                                          $i/RR
                                     }
                                     </row>'
                                     PASSING xfs.filecontent
                                     COLUMNS gbss_ref_no           PATH 'GBSSRefNo',
                                             colour_sequence       PATH 'colour_sequence',
                                             packtype              PATH 'packtype' ,
                                             case_qty              PATH 'PackQty',
                                             case_min_qty          PATH 'PackMinQty',
                                             case_cbm              PATH 'PackCBM',
                                             case_gwt              PATH 'PackGrossWeight',
                                             unit_cost             PATH 'VendorUnitCost',
                                             case_desc             PATH 'ProductName',
                                             ratiopk_repln_flag    PATH 'RR'
                                   ) xml
                    WHERE xfs.batch_num = p_nSdiBatchNum
                    )
            WHERE  NVL(case_qty,0)      > 0
            AND    NVL(case_min_qty, 0) > 0
            AND    gbss_ref_no          = l_vGbssRefNo
            AND    colour_sequence      = l_nColourSequence;

        CURSOR l_curGetTechKey(l_vProdNum    IN VARCHAR2,
                               l_vPackLetter IN VARCHAR2) IS
            SELECT vpc.vpc_prd_tech_key, vpc.vpc_primary_flag
            FROM   vpcprdee vpc
            WHERE  vpc.vpc_case_pack_id LIKE '%' || l_vPackLetter || '%'
            AND    EXISTS (SELECT 1
                           FROM   prdmstee prd
                           WHERE  prd.prd_lvl_child = vpc.prd_lvl_child
                           AND    prd.prd_lvl_number = RPAD(l_vProdNum, 15, ' ')
                          );
    BEGIN

        tar_generic_log_pkg.p_log(LC_vPGMNAME,
                                  tar_generic_log_pkg.gc_ntrace,
                                  tar_generic_log_pkg.gc_vstart);

        FOR l_rowRefColCnt IN l_curGetRefCol LOOP
            l_iRecCount := l_iRecCount + 1;
        END LOOP;

        IF l_iRecCount > 0 THEN
            dbms_output.put_line('Style available to process');
        ELSE
            dbms_output.put_line('No styles to process');
            RETURN;
        END IF;

        FOR l_rowRefCol IN l_curGetRefCol LOOP


            FOR l_recColQty IN l_curColCaseQty(l_rowRefCol.gbss_ref_no,
                                               l_rowRefCol.colour_sequence)
            LOOP

                BEGIN

                    FOR l_rowTechKey IN l_curGetTechKey(l_rowRefCol.product_number, l_recColQty.gbss_case_id) LOOP

                        BEGIN
                            INSERT INTO tar_vpcprdee(vpc_prd_tech_key)
                            VALUES( l_rowTechKey.vpc_prd_tech_key);

                        EXCEPTION
                            WHEN DUP_VAL_ON_INDEX THEN
                                 NULL;
                        END;

                         -- CR16B Change
                        l_nCbm := l_recColQty.case_cbm;

                        IF l_nCbm < LC_nMIN_CBM THEN
                            l_nCbm := LC_nMIN_CBM;
                        END IF;

                        UPDATE vpcprdee
                        SET    vpc_case_cube    = l_nCbm,
                               vpc_case_wgt     = l_recColQty.case_gwt,
                               vpc_case_wgt_uom = LC_vWT_UOM,
                               vpc_case_dim_uom = LC_vDIM_UOM,
                               vpc_case_desc    = SUBSTR(l_recColQty.case_desc,1,40)
                        WHERE  vpc_prd_tech_key = l_rowTechKey.vpc_prd_tech_key ;

                        UPDATE tar_vpcprdee
                        SET    vpc_unit_cost            = l_recColQty.unit_cost,
                               vpc_ratiopk_replen_flag  = l_recColQty.ratiopk_repln_flag
                        WHERE  vpc_prd_tech_key         = l_rowTechKey.vpc_prd_tech_key;

                    END LOOP;
                END;
            END LOOP;
        END LOOP;
        COMMIT;
        dbms_output.put_line(TO_CHAR(SYSDATE,'YYYY-MM-DD HH24:MI:SS')||'|INF|'||LC_vPGMNAME||'| Finished.');
    EXCEPTION
    WHEN OTHERS THEN
        dbms_output.put_line('Error in '|| LC_vPGMNAME ||': '||SQLCODE ||' - '|| SQLERRM);
        ROLLBACK WORK;
        RAISE;

    END p_UpdateCasepacksWithCBMandWGT;
    
    /************************************************************************
    *
    * NAME:        p_UpdateWebProductFeatures
    *
    * TYPE:        Procedure
    *
    * DESCRIPTION: This procedure updates the web product features of the product
    *              in order to add button batteries attribute into the product
    *              features.
    *
    * USAGE:       p_UpdateWebProductFeatures
    *
    *
    *************************************************************************
    * MODIFICATION HISTORY:
    * -----------------------------------------------------------------------
    * DEVELOPER         DATE        DESCRIPTION
    * -----------------------------------------------------------------------
    * Ronald Nava       05/08/2019  Initial version.
    *************************************************************************/

    PROCEDURE p_UpdateWebProductFeatures(p_nSdiBatchNum IN sdiprdmsi.batch_num%TYPE) IS

        /* Local Declarations */
        LC_vPGMNAME         CONSTANT VARCHAR2(30)                   := 'p_UpdateWebProductFeatures';
        LC_cWEB_CODE_WPF    CONSTANT tar_webadhee.web_adh_code%TYPE := 'WPF';
        LC_nPRD_NOT_FND     CONSTANT NUMBER(3)                      := 902;
        LC_cBUTTON_BAT_DEF  CONSTANT VARCHAR2(20)                   := 'Button Batteries - 0';
        LC_cATTR_TYP        CONSTANT VARCHAR2(20)                   := 'Product Profile';
        LC_cATTR_SUB_TYPE   CONSTANT VARCHAR2(20)                   := 'Button Batteries';

        l_nLvl1Child                 prdmstee.prd_lvl_child%TYPE;

        /* Main Cursor */

        CURSOR l_curRefColour IS
            SELECT gbss_ref_no,
                   colour_sequence,
                   product_number
            FROM   tar_gbss_sty_prd
            WHERE  upload_date IS NULL
            AND    sdi_reg_status = GC_cTRUE
            AND    batch_num = p_nSdiBatchNum;

        CURSOR l_curWebPrdFeats(l_vGbssRefNo     IN VARCHAR2,
                                l_nColourSequence IN NUMBER) IS
            SELECT gbss_ref_no,
                   colour_sequence,
                   button_battery
            FROM   (SELECT xml.gbss_ref_no,
                           xml.colour_sequence,
                           DECODE(xml.button_batteries,LC_cBUTTON_BAT_DEF,NULL,xml.button_batteries) button_battery
                    FROM   tar_gbss_prd_file_store xfs,
                           XMLTABLE('for $i in /Brief/Colour/Keycode/Attribute
                                     return <row>
                                     {
                                         <colour_sequence>{$i/../../@seq/string()}</colour_sequence>,
                                         $i/../../../GBSSRefNo,
                                         $i/Type,
                                         $i/SubType,
                                         $i/Code
                                     }
                                     </row>'
                                     PASSING xfs.filecontent
                                     COLUMNS gbss_ref_no         PATH 'GBSSRefNo',
                                             colour_sequence     PATH 'colour_sequence',
                                             type                PATH 'Type',
                                             subtype             PATH 'SubType',
                                             button_batteries    PATH 'Code'
                                   ) xml
                    WHERE  xfs.batch_num = p_nSdiBatchNum
                    AND    xml.type      = LC_cATTR_TYP
                    AND    xml.subtype   = LC_cATTR_SUB_TYPE
                    ) xmltab
             WHERE  gbss_ref_no = l_vGbssRefNo
             AND    colour_sequence = l_nColourSequence;

    BEGIN

        FOR l_rowRefColour IN l_curRefColour LOOP
            BEGIN
                FOR l_rowWebPrdFeats IN l_curWebPrdFeats(l_rowRefColour.gbss_ref_no,
                                                         l_rowRefColour.colour_sequence) LOOP

                    BEGIN
                        SELECT prd_lvl_child
                        INTO   l_nLvl1Child
                        FROM   prdmstee prd
                        WHERE  prd.prd_lvl_number = l_rowRefColour.product_number;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN

                            INSERT INTO tar_gbss_prd_sdi_upld_rej(script_name ,
                                                                  gbss_ref_no,
                                                                  product_number,
                                                                  colour_sequence,
                                                                  reason_code,
                                                                  comment1,
                                                                  comment2,
                                                                  comment3,
                                                                  error_date
                                                                  )
                            VALUES(LC_vPGMNAME,
                                   l_rowRefColour.gbss_ref_no,
                                   l_rowRefColour.product_number,
                                   l_rowRefColour.colour_sequence,
                                   LC_nPRD_NOT_FND,
                                   'product not found',
                                   NULL,
                                   NULL,
                                   SYSDATE);

                            UPDATE tar_gbss_sty_prd sty_prd
                            SET    sty_prd.overall_prd_reg_status = GC_cFALSE
                            WHERE  sty_prd.product_number         = l_rowRefColour.product_number
                            AND    sty_prd.batch_num = p_nSdiBatchNum;
                            EXIT;
                    END;

                    UPDATE tar_webprdee
                    SET    web_add_value = web_add_value||CHR(13)||CHR(10)||l_rowWebPrdFeats.button_battery
                    WHERE  prd_lvl_child = l_nLvl1Child
                    AND    web_adh_code  = LC_cWEB_CODE_WPF;
                        
                END LOOP;

            EXCEPTION
                WHEN OTHERS THEN
                ROLLBACK WORK;
            END;
        END LOOP;

   END p_UpdateWebProductFeatures;
/**************************************************************************************
*                  Package Initialisation
***************************************************************************************/

BEGIN

    dbms_output.enable(2000000);

END tar_gbss_prd_file_loading_pkg;
/
CREATE OR REPLACE PUBLIC SYNONYM tar_gbss_prd_file_loading_pkg FOR tarcomp.tar_gbss_prd_file_loading_pkg;
GRANT EXECUTE ON tar_gbss_prd_file_loading_pkg TO smstarg, targconv, target, oracle, system;
/
